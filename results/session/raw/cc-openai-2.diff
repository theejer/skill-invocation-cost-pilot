diff --git a/server.test.js b/server.test.js
new file mode 100644
index 0000000..5ab40b2
--- /dev/null
+++ b/server.test.js
@@ -0,0 +1,107 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { setTimeout: delay } = require('node:timers/promises');
+const { before, after, test } = require('node:test');
+
+let server;
+
+before(async () => {
+  const previousPort = process.env.PORT;
+  process.env.PORT = '0';
+  try {
+    server = require('./server');
+  } finally {
+    if (previousPort === undefined) delete process.env.PORT;
+    else process.env.PORT = previousPort;
+  }
+  if (!server.listening) await once(server, 'listening');
+});
+
+after(async () => {
+  if (server) await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+});
+
+const connect = () => {
+  const socket = net.createConnection({ host: '127.0.0.1', port: server.address().port, allowHalfOpen: true });
+  let response = '';
+  socket.setEncoding('latin1');
+  const completed = new Promise((resolve, reject) => {
+    socket.setTimeout(2000, () => socket.destroy(new Error('Response timed out')));
+    socket.on('error', reject);
+    socket.on('data', (chunk) => { response += chunk; });
+    socket.on('end', () => {
+      socket.end();
+      resolve(response);
+    });
+  });
+  return { socket, completed, response: () => response };
+};
+
+const exchange = async (request) => {
+  const { socket, completed } = connect();
+  socket.end(request, 'latin1');
+  return completed;
+};
+
+test('waits for headers and the complete body over a real connection', async () => {
+  const { socket, completed, response } = connect();
+  try {
+    await once(socket, 'connect');
+    socket.write('POST /echo HTTP/1.1\r\n');
+    await delay(40);
+    assert.equal(response(), '');
+    socket.write('Content-Length: 5\r\n\r\nhe');
+    await delay(40);
+    assert.equal(response(), '');
+    socket.write('llo');
+    const result = await completed;
+    assert.match(result, /^HTTP\/1\.1 200 OK\r\n/);
+    assert.ok(result.endsWith('\r\n\r\nPOST /echo'));
+    assert.match(result, /Connection: close\r\n/);
+  } finally {
+    socket.destroy();
+  }
+});
+
+test('returns /echo and existing route responses over TCP', async () => {
+  for (const [request, status, body] of [
+    ['GET /echo?test=1 HTTP/1.1\r\nHost: localhost\r\n\r\n', '200 OK', 'GET /echo'],
+    ['GET / HTTP/1.1\r\n\r\n', '200 OK', ''],
+    ['GET /users/1/posts/2 HTTP/1.1\r\n\r\n', '200 OK', '1 2'],
+    ['GET /missing HTTP/1.1\r\n\r\n', '404 Not Found', ''],
+    ['POST / HTTP/1.1\r\n\r\n', '405 Method Not Allowed', ''],
+  ]) {
+    const response = await exchange(request);
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}\r\n`));
+    assert.equal(response.split('\r\n\r\n')[1], body);
+  }
+});
+
+for (const request of [
+  'not a request\r\n\r\n',
+  'GET /echo invalid\r\n\r\n',
+  'GET /missing HTTP/1.1\r\nMalformed-Header\r\n\r\n',
+  'POST /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+  'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx',
+  'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+  'GET /echo HTTP/1.1',
+  'GET /echo HTTP/1.1\r\n',
+  'GET /echo HTTP/1.1\r\nHost: localhost\r\n',
+  'POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nabc',
+]) {
+  test(`returns 400 for malformed or incomplete request ${JSON.stringify(request)}`, async () => {
+    const response = await exchange(request);
+    assert.match(response, /^HTTP\/1\.1 400 Bad Request\r\n/);
+  });
+}
+
+test('returns 400 for oversized request lines and headers', async () => {
+  const requests = [
+    `GET /${'a'.repeat(8192)} HTTP/1.1\r\n\r\n`,
+    `GET /echo HTTP/1.1\r\nX-Test: ${'a'.repeat(65536)}\r\n\r\n`,
+  ];
+  for (const request of requests) {
+    assert.match(await exchange(request), /^HTTP\/1\.1 400 Bad Request\r\n/);
+  }
+});
