new file mode 100644
index 0000000..e506180
--- /dev/null
+++ b/request.js
@@ -0,0 +1,82 @@
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+\-.^_`|~0-9A-Za-z]+) (\/[^\x00-\x20\x7f#]*) (HTTP\/1\.[01])$/;
+const HEADER_PATTERN = /^([!#$%&'*+\-.^_`|~0-9A-Za-z]+):([\t\x20-\x7e\x80-\xff]*)$/;
+const MAX_HEADER_BYTES = 65536;
+
+class BadRequestError extends Error {}
+
+const parseRequestLine = (requestLine) => {
+  const match = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!match || match[0] !== requestLine) throw new BadRequestError('Invalid request line');
+
+  const [, method, target, version] = match;
+  const path = target.split('?')[0];
+  return { method, target, path, version };
+};
+
+const createRequestParser = ({ maxRequestLineBytes = 8192 } = {}) => {
+  let pendingBytes = Buffer.alloc(0);
+  let request = null;
+  let headerBytes = 0;
+  let readingHeaders = true;
+  let contentLength = 0;
+  let bodyBytes = 0;
+  let bodyChunks = [];
+
+  const readBody = (chunk) => {
+    const bodyChunk = chunk.subarray(0, contentLength - bodyBytes);
+    if (bodyChunk.length) bodyChunks.push(bodyChunk);
+    bodyBytes += bodyChunk.length;
+    if (bodyBytes < contentLength) return null;
+
+    request.body = Buffer.concat(bodyChunks, contentLength);
+    bodyChunks = [];
+    return request;
+  };
+
+  return (chunk) => {
+    if (request && request.body) return request;
+    if (!readingHeaders) return readBody(chunk);
+    pendingBytes = Buffer.concat([pendingBytes, chunk]);
+
+    while (readingHeaders) {
+      const lineEnd = pendingBytes.indexOf('\r\n');
+      const limit = request ? MAX_HEADER_BYTES - headerBytes : maxRequestLineBytes;
+      if (lineEnd === -1) {
+        if (pendingBytes.length >= limit) throw new BadRequestError('Request line or headers too large');
+        return null;
+      }
+      if (lineEnd + 2 > limit) throw new BadRequestError('Request line or headers too large');
+
+      const line = pendingBytes.toString('latin1', 0, lineEnd);
+      pendingBytes = pendingBytes.subarray(lineEnd + 2);
+      if (!request) {
+        request = { ...parseRequestLine(line), headers: Object.create(null) };
+        continue;
+      }
+
+      headerBytes += lineEnd + 2;
+      if (line === '') {
+        readingHeaders = false;
+        const body = pendingBytes;
+        pendingBytes = Buffer.alloc(0);
+        return readBody(body);
+      }
+
+      const headerMatch = HEADER_PATTERN.exec(line);
+      if (!headerMatch || headerMatch[0] !== line) throw new BadRequestError('Invalid header');
+      const name = headerMatch[1].toLowerCase();
+      const value = headerMatch[2].replace(/^[ \t]+|[ \t]+$/g, '');
+      if (name === 'transfer-encoding') throw new BadRequestError('Unsupported transfer encoding');
+      if (name === 'content-length') {
+        if (name in request.headers || !/^[0-9]+$/.test(value)) {
+          throw new BadRequestError('Invalid Content-Length');
+        }
+        contentLength = Number(value);
+        if (!Number.isSafeInteger(contentLength)) throw new BadRequestError('Invalid Content-Length');
+      }
+      request.headers[name] = name in request.headers ? `${request.headers[name]}, ${value}` : value;
+    }
+  };
+};
+
+module.exports = { BadRequestError, createRequestParser, parseRequestLine };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..7272cea
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,148 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { BadRequestError, createRequestParser, parseRequestLine } = require('./request');
+const { routeRequest, routeRequestLine } = require('./router');
+
+const parse = (rawRequest) => createRequestParser()(Buffer.from(rawRequest, 'latin1'));
+
+const responseBody = (response) => response.split('\r\n\r\n')[1];
+
+test('parses the request line, case-insensitive headers, and body', () => {
+  const request = parse('POST /echo?name=test HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 5\r\nX-Test:\t value \t\r\n\r\nhello');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.target, '/echo?name=test');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.headers['content-length'], '5');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.deepEqual(request.body, Buffer.from('hello'));
+});
+
+test('waits for the blank header line and the entire body', () => {
+  const parseRequest = createRequestParser();
+  assert.equal(parseRequest(Buffer.from('POST /echo HTTP/1.1\r\n')), null);
+  assert.equal(parseRequest(Buffer.from('Content-Length: 5\r\n\r\nhe')), null);
+  const request = parseRequest(Buffer.from('llo'));
+  assert.equal(request.body.toString(), 'hello');
+});
+
+test('handles every delimiter and a binary body split across TCP chunks', () => {
+  const body = Buffer.from([0, 255, 13, 10, 128]);
+  const bytes = Buffer.concat([
+    Buffer.from('PATCH /echo HTTP/1.0\r\nContent-Length: 5\r\n\r\n'),
+    body,
+  ]);
+  const parseRequest = createRequestParser();
+  for (let i = 0; i < bytes.length - 1; i++) {
+    assert.equal(parseRequest(bytes.subarray(i, i + 1)), null);
+  }
+  const request = parseRequest(bytes.subarray(-1));
+  assert.deepEqual(request.body, body);
+});
+
+test('Content-Length counts bytes, not characters', () => {
+  const parseRequest = createRequestParser();
+  const body = Buffer.from('é');
+  assert.equal(parseRequest(Buffer.concat([
+    Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 2\r\n\r\n'),
+    body.subarray(0, 1),
+  ])), null);
+  assert.deepEqual(parseRequest(body.subarray(1)).body, body);
+});
+
+test('requests without a body and zero-length bodies complete at the header terminator', () => {
+  for (const headers of ['', 'Content-Length: 0\r\n']) {
+    const request = parse(`GET /echo HTTP/1.1\r\n${headers}\r\n`);
+    assert.equal(request.body.length, 0);
+  }
+});
+
+test('does not include bytes beyond Content-Length in the body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcGET / HTTP/1.1\r\n\r\n');
+  assert.equal(request.body.toString(), 'abc');
+});
+
+test('normalizes repeated ordinary headers without inheriting object properties', () => {
+  const request = parse('GET / HTTP/1.1\r\nX-Test: one\r\nx-test: two\r\n__proto__: value\r\n\r\n');
+  assert.equal(request.headers['x-test'], 'one, two');
+  assert.equal(request.headers.__proto__, 'value');
+});
+
+for (const line of [
+  '',
+  'GET /',
+  'GET  / HTTP/1.1',
+  'GET / HTTP/2.0',
+  'GET / invalid',
+  'G(ET / HTTP/1.1',
+  'GET /bad\tpath HTTP/1.1',
+  'GET /bad#fragment HTTP/1.1',
+  'GET / HTTP/1.1 extra',
+  'GET / HTTP/1.1\n',
+]) {
+  test(`rejects malformed request line ${JSON.stringify(line)}`, () => {
+    assert.throws(() => parseRequestLine(line), BadRequestError);
+    assert.match(routeRequestLine(line), /^HTTP\/1\.1 400 Bad Request\r\n/);
+  });
+}
+
+for (const header of [
+  'No-Colon',
+  ': empty-name',
+  'Bad Name: value',
+  'Content-Length : 5',
+  ' folded: value',
+  'X-Test: value\n',
+  'X-Test: value\x00',
+  'Content-Length: -1',
+  'Content-Length: +1',
+  'Content-Length: 1.5',
+  'Content-Length: 1e2',
+  'Content-Length:',
+  'Content-Length: 9007199254740992',
+  'Content-Length: 1, 1',
+  'Content-Length: 1\r\ncontent-length: 1',
+  'Content-Length: 1\r\ncontent-length: 2',
+  'Transfer-Encoding: chunked',
+  'Content-Length: 1\r\nTransfer-Encoding: chunked',
+]) {
+  test(`rejects malformed or unsupported header ${JSON.stringify(header)}`, () => {
+    assert.throws(() => parse(`POST /echo HTTP/1.1\r\n${header}\r\n\r\nx`), BadRequestError);
+  });
+}
+
+test('enforces the configured request line limit including CRLF', () => {
+  const line = 'GET / HTTP/1.1\r\n';
+  const parseRequest = createRequestParser({ maxRequestLineBytes: Buffer.byteLength(line) });
+  assert.equal(parseRequest(Buffer.from(line.slice(0, -1))), null);
+  assert.equal(parseRequest(Buffer.from('\n\r\n')).path, '/');
+  assert.throws(() => createRequestParser({ maxRequestLineBytes: line.length - 1 })(Buffer.from(line)), BadRequestError);
+  assert.throws(() => createRequestParser({ maxRequestLineBytes: 4 })(Buffer.from('GET ')), BadRequestError);
+});
+
+test('enforces the header limit including CRLFs and handles exact boundary', () => {
+  const prefix = 'GET / HTTP/1.1\r\nX-Test: ';
+  assert.equal(parse(`${prefix}${'a'.repeat(65524)}\r\n\r\n`).path, '/');
+  assert.throws(() => parse(`${prefix}${'a'.repeat(65525)}\r\n\r\n`), BadRequestError);
+  assert.throws(() => parse(`${prefix}${'a'.repeat(65536)}`), BadRequestError);
+});
+
+test('/echo returns the method and path for any method, excluding the query', () => {
+  for (const method of ['GET', 'POST', 'PATCH', 'DELETE', 'HEAD']) {
+    const response = routeRequestLine(`${method} /echo?name=test HTTP/1.1`);
+    assert.match(response, /^HTTP\/1\.1 200 OK\r\n/);
+    assert.match(response, /Content-Type: text\/plain\r\n/);
+    assert.equal(responseBody(response), `${method} /echo`);
+    assert.ok(response.includes(`Content-Length: ${Buffer.byteLength(`${method} /echo`)}\r\n`));
+  }
+});
+
+test('preserves the root, user post, unknown route, and method responses', () => {
+  assert.equal(responseBody(routeRequest({ method: 'GET', path: '/' })), '');
+  assert.equal(responseBody(routeRequestLine('GET /users/12/posts/34 HTTP/1.1')), '12 34');
+  assert.match(routeRequestLine('GET /missing HTTP/1.1'), /^HTTP\/1\.1 404 Not Found\r\n/);
+  const response = routeRequestLine('POST / HTTP/1.1');
+  assert.match(response, /^HTTP\/1\.1 405 Method Not Allowed\r\n/);
+  assert.match(response, /Allow: GET\r\n/);
+});
