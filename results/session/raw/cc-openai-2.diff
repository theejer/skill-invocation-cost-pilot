diff --git a/request.js b/request.js
new file mode 100644
index 0000000..155487e
--- /dev/null
+++ b/request.js
@@ -0,0 +1,55 @@
+const TOKEN_PATTERN = /^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/;
+const REQUEST_LINE_PATTERN = /^([^ ]+) (\/[^\x00-\x20\x7f]*) HTTP\/(1\.[01])$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequest = (receivedBytes, maxRequestLineBytes = 8192) => {
+  const requestLineEnd = receivedBytes.indexOf('\r\n');
+  if (requestLineEnd === -1) {
+    if (receivedBytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (requestLineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+
+  const match = REQUEST_LINE_PATTERN.exec(receivedBytes.toString('latin1', 0, requestLineEnd));
+  if (!match || !TOKEN_PATTERN.test(match[1])) throw new Error('Invalid request line');
+
+  const headerEnd = receivedBytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (receivedBytes.length >= MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+
+  const headers = Object.create(null);
+  const headerLines = receivedBytes.toString('latin1', requestLineEnd + 2, headerEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN_PATTERN.test(name) || /[^\t\x20-\x7e\x80-\xff]/.test(line.slice(colon + 1))) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) throw new Error('Duplicate Content-Length');
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const contentLength = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(contentLength) || !Number.isSafeInteger(Number(contentLength))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headerEnd + 4;
+  const bodyLength = Number(contentLength);
+  if (receivedBytes.length - bodyStart < bodyLength) return null;
+
+  return {
+    method: match[1],
+    path: match[2],
+    version: match[3],
+    headers,
+    body: receivedBytes.subarray(bodyStart, bodyStart + bodyLength),
+  };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..1bae6c0
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,90 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { spawn } = require('node:child_process');
+const net = require('node:net');
+const { parseRequest } = require('./request');
+const { routeRequest } = require('./router');
+
+const parse = (text) => parseRequest(Buffer.from(text, 'latin1'));
+
+test('parses request line, case-insensitive headers and byte-length body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nContent-Length: 3\r\nX-Test: value\r\n\r\nabcignored');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.equal(request.body.toString(), 'abc');
+  assert.match(routeRequest(request), /\r\n\r\nPOST \/echo$/);
+});
+
+test('waits for complete headers and body', () => {
+  assert.equal(parse('GET /echo HTTP/1.1\r\n'), null);
+  assert.equal(parse('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc'), null);
+  assert.equal(parse('GET / HTTP/1.1\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed lines, headers and body framing', () => {
+  for (const request of [
+    'GET / HTTP/9.9\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nMissing-Colon\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 1.5\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 9007199254740992\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n',
+    'GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parse(request));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
+
+test('preserves existing routes', () => {
+  assert.match(routeRequest(parse('GET / HTTP/1.1\r\n\r\n')), /^HTTP\/1.1 200/);
+  assert.match(routeRequest(parse('GET /users/12/posts/34 HTTP/1.1\r\n\r\n')), /\r\n\r\n12 34$/);
+  assert.match(routeRequest(parse('POST / HTTP/1.1\r\n\r\n')), /^HTTP\/1.1 405/);
+  assert.match(routeRequest(parse('GET /missing HTTP/1.1\r\n\r\n')), /^HTTP\/1.1 404/);
+});
+
+test('server handles fragmented requests and returns 400 for truncated input', async (t) => {
+  const reservation = net.createServer();
+  await new Promise((resolve) => reservation.listen(0, '127.0.0.1', resolve));
+  const port = reservation.address().port;
+  await new Promise((resolve) => reservation.close(resolve));
+  const child = spawn(process.execPath, ['server.js'], {
+    cwd: __dirname,
+    env: { ...process.env, PORT: String(port) },
+    stdio: 'pipe',
+  });
+  t.after(() => child.kill());
+
+  const connect = () => new Promise((resolve, reject) => {
+    const socket = net.connect(port, '127.0.0.1');
+    socket.once('connect', () => resolve(socket));
+    socket.once('error', reject);
+  });
+  let socket;
+  for (let attempt = 0; attempt < 100; attempt++) {
+    try { socket = await connect(); break; } catch {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+  }
+  assert.ok(socket, 'server started');
+  const response = (conn) => new Promise((resolve, reject) => {
+    let data = '';
+    conn.on('data', (chunk) => { data += chunk.toString('latin1'); });
+    conn.on('end', () => resolve(data));
+    conn.on('error', reject);
+  });
+  const echoed = response(socket);
+  socket.write('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(socket.readableEnded, false);
+  socket.write('cd');
+  assert.match(await echoed, /\r\n\r\nPOST \/echo$/);
+
+  for (const input of ['GET / HTTP/1.1\r\nBroken\r\n\r\n', 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab']) {
+    const conn = await connect();
+    const result = response(conn);
+    conn.end(input);
+    assert.match(await result, /^HTTP\/1.1 400 Bad Request/);
+  }
+});
