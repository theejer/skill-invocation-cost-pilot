diff --git a/request.js b/request.js
new file mode 100644
index 0000000..c0519d5
--- /dev/null
+++ b/request.js
@@ -0,0 +1,37 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+
+// Parses a request head (request line + headers, without the blank line).
+// Returns { method, target, headers, contentLength }, or null if malformed.
+const parseRequestHead = (head, maxBodyBytes) => {
+  const [requestLine, ...headerLines] = head.split(LINE_END);
+
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+  const [, method, target] = requestLineMatch;
+
+  const headers = {};
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  // Chunked bodies are not supported, so framing would be ambiguous.
+  if ('transfer-encoding' in headers) return null;
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    // A repeated Content-Length with differing values was joined above and fails this check.
+    if (!CONTENT_LENGTH_PATTERN.test(headers['content-length'])) return null;
+    contentLength = Number(headers['content-length']);
+    if (!Number.isSafeInteger(contentLength) || contentLength > maxBodyBytes) return null;
+  }
+
+  return { method, target, headers, contentLength };
+};
+
+module.exports = { parseRequestHead };
