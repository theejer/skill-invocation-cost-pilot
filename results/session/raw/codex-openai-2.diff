diff --git a/request.js b/request.js
new file mode 100644
index 0000000..58e428e
--- /dev/null
+++ b/request.js
@@ -0,0 +1,49 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\x00-\x20\x7f]*|\*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+
+// Return null until a complete request is available. Bodies remain raw bytes.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match) throw new Error('Invalid request line');
+
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length > MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+  const headers = Object.create(null);
+  const headerText = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value.trim() : `${headers[key]}, ${value.trim()}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^\d+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headerEnd + 4;
+  const bodyLength = Number(length);
+  if (bytes.length - bodyStart < bodyLength) return null;
+  const [, method, target] = match;
+  return { method, target, path: target.split('?')[0], headers, body: bytes.subarray(bodyStart, bodyStart + bodyLength) };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..4d206ba
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,76 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const { parseRequest } = require('./request');
+const { routeRequest } = require('./router');
+
+test('parses headers and a binary body across every chunk boundary', () => {
+  const body = Buffer.from([0, 255, 13, 10]);
+  const bytes = Buffer.concat([Buffer.from('POST /echo?q=1 HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 4\r\n\r\n'), body]);
+  for (let end = 0; end < bytes.length; end++) {
+    assert.equal(parseRequest(bytes.subarray(0, end)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, body);
+  assert.ok(routeRequest(request).endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('rejects malformed request lines, headers and body framing', () => {
+  for (const request of [
+    'GET / HTTP/9.9\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nX: a\nb\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 1.5\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 9007199254740992\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n',
+    'GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parseRequest(Buffer.from(request)));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
+
+test('preserves existing routes', () => {
+  const response = (method, target) => routeRequest({ method, target, path: target });
+  assert.match(response('GET', '/'), /^HTTP\/1.1 200/);
+  assert.ok(response('GET', '/users/alice/posts/42').endsWith('\r\n\r\nalice 42'));
+  assert.match(response('POST', '/'), /^HTTP\/1.1 405/);
+  assert.match(response('GET', '/missing'), /^HTTP\/1.1 404/);
+});
+
+test('server waits for the body and returns 400 for truncated requests', async (t) => {
+  const server = spawn(process.execPath, ['server.js'], { env: { ...process.env, PORT: '0' }, stdio: ['ignore', 'pipe', 'pipe', 'ipc'] });
+  t.after(() => server.kill());
+  const port = await new Promise((resolve, reject) => {
+    server.once('message', resolve);
+    server.once('error', reject);
+    server.once('exit', (code) => reject(new Error(`Server exited: ${code}`)));
+  });
+  const exchange = (request) => new Promise((resolve, reject) => {
+    const socket = net.connect(port, '127.0.0.1');
+    let response = '';
+    socket.on('connect', () => socket.end(request));
+    socket.on('data', (chunk) => { response += chunk; });
+    socket.on('end', () => resolve(response));
+    socket.on('error', reject);
+  });
+  const socket = net.connect(port, '127.0.0.1');
+  t.after(() => socket.destroy());
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk; });
+  await new Promise((resolve) => socket.once('connect', resolve));
+  socket.write('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 50));
+  assert.equal(response, '');
+  socket.write('cd');
+  await new Promise((resolve) => socket.once('end', resolve));
+  assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+  assert.match(await exchange('GET / HTTP/1.1\r\n'), /^HTTP\/1.1 400/);
+  assert.match(await exchange('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab'), /^HTTP\/1.1 400/);
+  assert.match(await exchange('GET / HTTP/1.1\r\nBroken\r\n\r\n'), /^HTTP\/1.1 400/);
+});
