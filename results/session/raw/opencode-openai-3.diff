--- /dev/null
+++ b/request.js
@@ -0,0 +1,51 @@
+const TOKEN = "[!#$%&'*+.^_`|~0-9A-Za-z-]+";
+const REQUEST_LINE_PATTERN = new RegExp(`^(${TOKEN}) ([^\\x00-\\x20\\x7f]+) (HTTP/1\\.[01])$`);
+const HEADER_NAME_PATTERN = new RegExp(`^${TOKEN}$`);
+
+const badRequest = () => {
+  throw new Error('Malformed request');
+};
+
+// Return null until the complete headers and Content-Length body have arrived.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const requestLineEnd = bytes.indexOf('\r\n');
+  if (requestLineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes || bytes.includes('\n')) badRequest();
+    return null;
+  }
+  if (requestLineEnd + 2 > maxRequestLineBytes) badRequest();
+
+  const match = REQUEST_LINE_PATTERN.exec(bytes.toString('latin1', 0, requestLineEnd));
+  if (!match) badRequest();
+  const [, method, path, version] = match;
+  if (!path.startsWith('/') && path !== '*') badRequest();
+
+  const headersEnd = bytes.indexOf('\r\n\r\n', requestLineEnd);
+  if (headersEnd === -1) return null;
+  const headers = Object.create(null);
+  const headerText = bytes.toString('latin1', requestLineEnd + 2, headersEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon < 1 || !HEADER_NAME_PATTERN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      badRequest();
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) badRequest();
+    headers[key] = headers[key] === undefined ? value.trim() : `${headers[key]}, ${value.trim()}`;
+  }
+
+  // Chunked framing is not supported; do not silently interpret it as an empty body.
+  if (headers['transfer-encoding'] !== undefined) badRequest();
+  const lengthText = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(lengthText)) badRequest();
+  const contentLength = Number(lengthText);
+  if (!Number.isSafeInteger(contentLength)) badRequest();
+  const bodyStart = headersEnd + 4;
+  if (bytes.length - bodyStart < contentLength) return null;
+
+  return { method, path, version, headers, body: bytes.subarray(bodyStart, bodyStart + contentLength) };
+};
+
+module.exports = { parseRequest };
