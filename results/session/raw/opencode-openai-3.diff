diff --git a/request.js b/request.js
new file mode 100644
index 0000000..c5a38d5
--- /dev/null
+++ b/request.js
@@ -0,0 +1,55 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\s#]*|\*) (HTTP\/1\.[01])$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE.exec(line);
+  if (!match) throw new Error('Invalid request line');
+  const [, method, path, version] = match;
+  return { method, path, version };
+};
+
+// null means that more bytes are needed; invalid requests throw.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length >= MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+
+  const headers = Object.create(null);
+  const lines = bytes.toString('latin1', lineEnd + 2, headerEnd).split('\r\n');
+  if (headerEnd === lineEnd) lines.length = 0;
+  for (const line of lines) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value.trim() : `${headers[key]}, ${value.trim()}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headerEnd + 4;
+  const bodyLength = Number(length);
+  if (bytes.length - bodyStart < bodyLength) return null;
+  return { ...request, headers, body: bytes.subarray(bodyStart, bodyStart + bodyLength) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..579a37a
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,76 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const net = require('node:net');
+const { parseRequest } = require('./request');
+const { routeRequest } = require('./router');
+const server = require('./server');
+
+test('parses headers case-insensitively and reads body bytes', () => {
+  const bytes = Buffer.concat([
+    Buffer.from('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\n'),
+    Buffer.from([0, 255, 10]),
+  ]);
+  for (let length = 0; length < bytes.length; length++) {
+    assert.equal(parseRequest(bytes.subarray(0, length)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([0, 255, 10]));
+  assert.match(routeRequest(request), /\r\n\r\nPOST \/echo$/);
+});
+
+test('rejects malformed request lines, headers and framing', () => {
+  for (const request of [
+    'GET / HTTP/9.9\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad header: x\r\n\r\n',
+    'GET / HTTP/1.1\r\nMissingColon\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 1x\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 9007199254740992\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n',
+    'GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parseRequest(Buffer.from(request)), undefined, request);
+  assert.throws(() => parseRequest(Buffer.alloc(8192, 65)));
+});
+
+test('preserves existing routes and supports empty headers', () => {
+  for (const [method, path, status, body] of [
+    ['GET', '/', '200 OK', ''],
+    ['GET', '/users/alice/posts/42', '200 OK', 'alice 42'],
+    ['POST', '/', '405 Method Not Allowed', ''],
+    ['GET', '/missing', '404 Not Found', ''],
+    ['DELETE', '/echo', '200 OK', 'DELETE /echo'],
+  ]) {
+    const response = routeRequest(parseRequest(Buffer.from(`${method} ${path} HTTP/1.1\r\n\r\n`)));
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}\r\n`));
+    assert.equal(response.split('\r\n\r\n')[1], body);
+  }
+});
+
+test('server waits for body and returns 400 on malformed or truncated input', async (t) => {
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  const exchange = (chunks) => new Promise((resolve, reject) => {
+    const client = net.connect(server.address().port, '127.0.0.1');
+    let response = '';
+    client.on('error', reject);
+    client.on('data', (chunk) => { response += chunk.toString(); });
+    client.on('end', () => resolve(response));
+    client.on('connect', async () => {
+      for (const chunk of chunks) {
+        client.write(chunk);
+        await new Promise((done) => setTimeout(done, 10));
+      }
+      client.end();
+    });
+  });
+  assert.match(await exchange(['POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\n', 'te', 'st']), /200 OK[\s\S]*POST \/echo$/);
+  for (const input of [
+    'GET / HTTP/1.1\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nx',
+    'GET / HTTP/1.1\r\nInvalid\r\n\r\n',
+  ]) assert.match(await exchange([input]), /^HTTP\/1.1 400 Bad Request/);
+});
