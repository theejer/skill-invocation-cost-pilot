diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..7dcbdf9
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,54 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { parseRequest } = require('../request');
+
+const parse = (text, limit) => parseRequest(Buffer.from(text, 'latin1'), limit);
+
+test('parses request line, case-insensitive headers, and binary body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\nCONTENT-Length: 3\r\n\r\na\x00\xff');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([97, 0, 255]));
+});
+
+test('waits for headers and the complete body at every chunk boundary', () => {
+  const text = 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ntest';
+  for (let end = 0; end < text.length; end++) {
+    assert.equal(parse(text.slice(0, end)), null, `prefix length ${end}`);
+  }
+  assert.equal(parse(text).body.toString(), 'test');
+});
+
+test('accepts empty headers and zero-length bodies', () => {
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+  assert.equal(parse('POST /echo HTTP/1.1\r\nContent-Length: 0\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed request lines, headers, and body framing', () => {
+  const invalid = [
+    'GET /\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/2.0\r\n\r\n',
+    'GET / HTTP/1.1\n\n',
+    'G(ET / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nNo colon\r\n\r\n',
+    'GET / HTTP/1.1\r\nHost : localhost\r\n\r\n',
+    'GET / HTTP/1.1\r\n folded: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nHost: bad\x00value\r\n\r\n',
+    ...['-1', '+2', '1.5', 'abc', '', '9007199254740992'].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\na',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ];
+  for (const text of invalid) assert.throws(() => parse(text), /Malformed request/);
+});
+
+test('enforces the request-line byte limit including CRLF', () => {
+  const line = 'GET / HTTP/1.1\r\n';
+  assert.ok(parse(`${line}\r\n`, line.length));
+  assert.throws(() => parse(`${line}\r\n`, line.length - 1));
+  assert.throws(() => parse('x'.repeat(20), 20));
+});
diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..d142b89
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,78 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { test, before, after } = require('node:test');
+const server = require('../server');
+
+before(async () => {
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+});
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const connect = async () => {
+  const socket = net.createConnection(server.address().port, '127.0.0.1');
+  socket.setTimeout(2000, () => socket.destroy(new Error('Request timed out')));
+  await once(socket, 'connect');
+  return socket;
+};
+
+const responseFrom = (socket) => new Promise((resolve, reject) => {
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.on('data', (chunk) => { response += chunk; });
+  socket.on('end', () => resolve(response));
+  socket.on('error', reject);
+});
+
+const exchange = async (request) => {
+  const socket = await connect();
+  const response = responseFrom(socket);
+  socket.end(request);
+  return response;
+};
+
+test('echo accepts methods and returns method and path', async () => {
+  const response = await exchange('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc');
+  assert.match(response, /^HTTP\/1.1 200 OK\r\n/);
+  assert.match(response, /Content-Length: 10\r\n/);
+  assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('does not respond before all headers and body bytes arrive', async () => {
+  const socket = await connect();
+  const response = responseFrom(socket);
+  let received = false;
+  socket.on('data', () => { received = true; });
+  socket.write('POST /echo HTTP/1.1\r\n');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(received, false);
+  socket.write('Content-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(received, false);
+  socket.end('cd');
+  assert.match(await response, /^HTTP\/1.1 200 OK/);
+});
+
+test('returns 400 for malformed and truncated requests', async () => {
+  for (const request of [
+    'invalid\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken header\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: nope\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab',
+    'GET / HTTP/1.1\r\n',
+  ]) assert.match(await exchange(request), /^HTTP\/1.1 400 Bad Request/);
+});
+
+test('preserves existing routes and method handling', async () => {
+  for (const [method, path, status, body] of [
+    ['GET', '/', '200 OK', ''],
+    ['GET', '/users/12/posts/34', '200 OK', '12 34'],
+    ['POST', '/', '405 Method Not Allowed', ''],
+    ['GET', '/missing', '404 Not Found', ''],
+  ]) {
+    const response = await exchange(`${method} ${path} HTTP/1.1\r\n\r\n`);
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}\r\n`));
+    assert.ok(response.endsWith(`\r\n\r\n${body}`));
+  }
+});
