diff --git a/request.js b/request.js
new file mode 100644
index 0000000..18677a2
--- /dev/null
+++ b/request.js
@@ -0,0 +1,50 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\s\x00-\x20\x7f]*) HTTP\/1\.[01]$/;
+
+// null means more bytes are needed; malformed requests throw.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match) throw new Error('Invalid request line');
+
+  const headers = Object.create(null);
+  let offset = lineEnd + 2;
+  while (true) {
+    const end = bytes.indexOf('\r\n', offset);
+    if (end === -1) return null;
+    if (end === offset) {
+      offset = end + 2;
+      break;
+    }
+    const line = bytes.toString('latin1', offset, end);
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(line)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+    offset = end + 2;
+  }
+
+  // Transfer-Encoding is unsupported: never guess where its body ends.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyLength = Number(length);
+  if (bytes.length - offset < bodyLength) return null;
+  return { method: match[1], path: match[2], headers, body: bytes.subarray(offset, offset + bodyLength) };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..ca9e859
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,36 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parseRequest } = require('./request');
+const { routeRequest } = require('./router');
+
+test('reads headers and waits for a complete byte-length body', () => {
+  const bytes = Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 3\r\nX-Test: value\r\n\r\nabc');
+  for (let end = 0; end < bytes.length; end++) {
+    assert.equal(parseRequest(bytes.subarray(0, end)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.equal(request.body.toString(), 'abc');
+  assert.match(routeRequest(request), /\r\n\r\nPOST \/echo$/);
+});
+
+test('rejects malformed requests', () => {
+  for (const raw of [
+    'GET / HTTP/2.0\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad header: x\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\na',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parseRequest(Buffer.from(raw)));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
+
+test('preserves existing routes', () => {
+  assert.match(routeRequest({ method: 'GET', path: '/' }), /^HTTP\/1.1 200/);
+  assert.match(routeRequest({ method: 'GET', path: '/users/1/posts/2' }), /\r\n\r\n1 2$/);
+  assert.match(routeRequest({ method: 'POST', path: '/' }), /^HTTP\/1.1 405/);
+  assert.match(routeRequest({ method: 'GET', path: '/missing' }), /^HTTP\/1.1 404/);
+});
