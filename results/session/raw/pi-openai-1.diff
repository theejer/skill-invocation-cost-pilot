diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..3edc4fd
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,67 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { parseRequest } = require('../request');
+const { createServer } = require('../server');
+
+const parse = (text) => parseRequest(Buffer.from(text, 'latin1'));
+
+test('parses method, path, case-insensitive headers and a byte-counted body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\n\xffabextra');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([255, 97, 98]));
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+});
+
+test('waits for complete request line, headers and body at every byte boundary', () => {
+  const text = 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ntest';
+  for (let i = 0; i < text.length; i++) assert.equal(parse(text.slice(0, i)), null);
+  assert.equal(parse(text).body.toString(), 'test');
+});
+
+test('rejects malformed request lines and headers', () => {
+  const malformed = [
+    'GET / NOT-HTTP\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'G\tET / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nMissingColon\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nX: a\x00b\r\n\r\n',
+    ...['-1', '1.5', 'abc', '', '9007199254740992'].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\na',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ];
+  for (const text of malformed) assert.throws(() => parse(text), undefined, text);
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
+
+test('server routes complete requests and rejects truncated requests', async (t) => {
+  const server = createServer();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+
+  const exchange = async (request) => {
+    const socket = net.connect(server.address().port, '127.0.0.1');
+    socket.setEncoding('latin1');
+    let response = '';
+    socket.on('data', (chunk) => { response += chunk; });
+    const ended = once(socket, 'end');
+    socket.end(request);
+    await ended;
+    return response;
+  };
+  assert.match(await exchange('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc'), /200 OK[\s\S]*\r\n\r\nPOST \/echo$/);
+  assert.match(await exchange('GET / HTTP/1.1\r\n\r\n'), /200 OK/);
+  assert.match(await exchange('GET /users/12/posts/34 HTTP/1.1\r\n\r\n'), /\r\n\r\n12 34$/);
+  assert.match(await exchange('POST / HTTP/1.1\r\n\r\n'), /405 Method Not Allowed/);
+  assert.match(await exchange('GET /missing HTTP/1.1\r\n\r\n'), /404 Not Found/);
+  for (const request of ['GET / HTTP/1.1\r\n', 'invalid\r\n\r\n', 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab']) {
+    assert.match(await exchange(request), /400 Bad Request/);
+  }
+});
