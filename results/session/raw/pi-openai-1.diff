index 0000000..fb109c7
--- /dev/null
+++ b/request.js
@@ -0,0 +1,60 @@
+const TOKEN = /^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/;
+const REQUEST_LINE = /^([^ ]+) (\/[^\x00-\x20\x7f]*|\*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE.exec(line);
+  if (!match || /[\x00-\x1f\x7f]/.test(line) || !TOKEN.test(match[1])) {
+    throw new Error('Invalid request line');
+  }
+  return { method: match[1], path: match[2] };
+};
+
+// Returns null until the entire request (including its body) has arrived.
+// Throws for malformed framing; body lengths are measured in bytes, not characters.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length - lineEnd - 2 > MAX_HEADER_BYTES) throw new Error('Headers too long');
+    return null;
+  }
+  if (headerEnd - lineEnd > MAX_HEADER_BYTES) throw new Error('Headers too long');
+
+  const headers = Object.create(null);
+  const headerText = headerEnd === lineEnd ? '' : bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(line)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+  // Chunked transfer coding is not supported; never interpret it as an empty body.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const lengthText = headers['content-length'];
+  if (lengthText !== undefined && !/^[0-9]+$/.test(lengthText)) {
+    throw new Error('Invalid Content-Length');
+  }
+  const length = lengthText === undefined ? 0 : Number(lengthText);
+  if (!Number.isSafeInteger(length) || length > Number.MAX_SAFE_INTEGER - headerEnd - 4) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headerEnd + 4;
+  if (bytes.length < bodyStart + length) return null;
+  return { ...request, headers, body: bytes.subarray(bodyStart, bodyStart + length) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
