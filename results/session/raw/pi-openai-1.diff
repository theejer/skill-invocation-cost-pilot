diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..489aa4b
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,42 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parseRequest } = require('../request');
+const { routeRequest } = require('../router');
+const parse = (text) => parseRequest(Buffer.from(text, 'latin1'));
+
+test('reads request line, case-insensitive headers and binary body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nContent-Length: 3\r\nX-Test: value\r\n\r\na\x00b');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.deepEqual(request.body, Buffer.from([97, 0, 98]));
+  assert.match(routeRequest(request), /\r\n\r\nPOST \/echo$/);
+});
+
+test('waits for headers and complete body at every chunk boundary', () => {
+  const text = 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ntest';
+  for (let i = 0; i < text.length; i++) assert.equal(parse(text.slice(0, i)), null);
+  assert.equal(parse(text).body.toString(), 'test');
+});
+
+test('accepts empty headers and preserves existing routes', () => {
+  assert.equal(parse('GET / HTTP/1.1\r\n\r\n').body.length, 0);
+  assert.match(routeRequest(parse('GET / HTTP/1.1\r\n\r\n')), /200 OK/);
+  assert.match(routeRequest(parse('GET /users/1/posts/2 HTTP/1.1\r\n\r\n')), /\r\n\r\n1 2$/);
+  assert.match(routeRequest(parse('POST / HTTP/1.1\r\n\r\n')), /405 Method Not Allowed/);
+  assert.match(routeRequest(parse('GET /missing HTTP/1.1\r\n\r\n')), /404 Not Found/);
+});
+
+test('rejects malformed requests and ambiguous framing', () => {
+  for (const text of [
+    'GET / INVALID\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: x\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 2x\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 0\r\ncontent-length: 0\r\n\r\n',
+    'GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parse(text));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
