+Routes: `/`, `/users/{id}/posts/{id}`, and `/echo` (replies with the request method and path). The server parses the request line, headers and any `Content-Length` body, and replies `400 Bad Request` to malformed requests.
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..a93c2dc
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,78 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+const HEADERS_END = '\r\n\r\n';
+
+const INCOMPLETE = { state: 'incomplete' };
+const INVALID = { state: 'invalid' };
+
+const parseHeaders = (headerBlock) => {
+  const headerValues = new Map();
+  const headerLines = headerBlock === '' ? [] : headerBlock.split(LINE_END);
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+
+    const name = headerMatch[1].toLowerCase();
+    headerValues.set(name, [...(headerValues.get(name) ?? []), headerMatch[2]]);
+  }
+  return headerValues;
+};
+
+const readContentLength = (headerValues, maxBodyBytes) => {
+  if (headerValues.has('transfer-encoding')) return null;
+  if (!headerValues.has('content-length')) return 0;
+
+  const distinctValues = [...new Set(headerValues.get('content-length'))];
+  if (distinctValues.length !== 1 || !CONTENT_LENGTH_PATTERN.test(distinctValues[0])) return null;
+
+  const contentLength = Number(distinctValues[0]);
+  return Number.isSafeInteger(contentLength) && contentLength <= maxBodyBytes ? contentLength : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? INVALID : INCOMPLETE;
+  }
+
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(receivedBytes.toString('latin1', 0, requestLineEnd));
+  if (!requestLineMatch) return INVALID;
+
+  const headersEnd = receivedBytes.indexOf(HEADERS_END, requestLineEnd);
+  if (headersEnd === -1) {
+    const pendingHeaderBytes = receivedBytes.length - requestLineEnd;
+    return pendingHeaderBytes > maxHeaderBytes ? INVALID : INCOMPLETE;
+  }
+  if (headersEnd - requestLineEnd > maxHeaderBytes) return INVALID;
+
+  const headerBlock =
+    headersEnd > requestLineEnd
+      ? receivedBytes.toString('latin1', requestLineEnd + LINE_END.length, headersEnd)
+      : '';
+  const headerValues = parseHeaders(headerBlock);
+  if (!headerValues) return INVALID;
+
+  const contentLength = readContentLength(headerValues, maxBodyBytes);
+  if (contentLength === null) return INVALID;
+
+  const bodyStart = headersEnd + HEADERS_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return INCOMPLETE;
+
+  const headers = Object.fromEntries(
+    [...headerValues].map(([name, values]) => [name, values.join(', ')]),
+  );
+  const [, method, target] = requestLineMatch;
+  return {
+    state: 'complete',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.toString('latin1', bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
