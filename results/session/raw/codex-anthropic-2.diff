 Minimum Node.js version: 22
 
 Port: 8080
+
+Routes: `GET /` , `/users/:id/posts/:id`, and `/echo` (any method; replies with the method and path).
+
+Requests are parsed as request line, headers, and a `Content-Length` body. Malformed requests get `400 Bad Request`; bodies over `MAX_BODY_BYTES` get `413`. Limits: `MAX_REQUEST_LINE_BYTES`, `MAX_HEADER_BYTES`, `MAX_BODY_BYTES`.
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..8c8020d
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,76 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+const HEAD_END = '\r\n\r\n';
+
+const INCOMPLETE = { status: 'incomplete' };
+const BAD_REQUEST = { status: 'bad' };
+const BODY_TOO_LARGE = { status: 'too-large' };
+
+const parseHeaders = (headerLines) => {
+  const headers = new Map();
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    const values = headers.get(name) ?? [];
+    values.push(headerMatch[2]);
+    headers.set(name, values);
+  }
+  return headers;
+};
+
+const parseContentLength = (headers) => {
+  const values = headers.get('content-length');
+  if (!values) return 0;
+
+  const candidates = values.flatMap((value) => value.split(',').map((part) => part.trim()));
+  if (!candidates.every((candidate) => CONTENT_LENGTH_PATTERN.test(candidate))) return null;
+  if (new Set(candidates).size !== 1) return null;
+
+  const contentLength = Number(candidates[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    return receivedBytes.length >= maxHeaderBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(
+    receivedBytes.toString('latin1', 0, requestLineEnd),
+  );
+  if (!requestLineMatch) return BAD_REQUEST;
+
+  const headerSection = receivedBytes.toString('latin1', requestLineEnd, headEnd);
+  const headerLines = headerSection === '' ? [] : headerSection.slice(LINE_END.length).split(LINE_END);
+  const headers = parseHeaders(headerLines);
+  if (!headers || headers.has('transfer-encoding')) return BAD_REQUEST;
+
+  const contentLength = parseContentLength(headers);
+  if (contentLength === null) return BAD_REQUEST;
+  if (contentLength > maxBodyBytes) return BODY_TOO_LARGE;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length - bodyStart < contentLength) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    status: 'ok',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
