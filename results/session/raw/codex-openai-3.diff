diff --git a/request.js b/request.js
new file mode 100644
index 0000000..aaba8b7
--- /dev/null
+++ b/request.js
@@ -0,0 +1,52 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([^ ]+) (\/[^\x00-\x20\x7f]*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+const MAX_BODY_BYTES = 1024 * 1024;
+
+const malformed = () => { throw new Error('Malformed request'); };
+
+// Returns null until the complete request (including its body) has arrived.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) malformed();
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) malformed();
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match || !TOKEN.test(match[1])) malformed();
+
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length >= MAX_HEADER_BYTES) malformed();
+    return null;
+  }
+  const bodyStart = headerEnd + 4;
+  if (bodyStart > MAX_HEADER_BYTES) malformed();
+  const headers = Object.create(null);
+  const headerLines = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN.test(name) || /[^\t\x20-\x7e\x80-\xff]/.test(line.slice(colon + 1))) malformed();
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) malformed();
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+  // Transfer codings cannot be safely framed by this Content-Length parser.
+  if (headers['transfer-encoding'] !== undefined) malformed();
+  const lengthValue = headers['content-length'];
+  if (lengthValue !== undefined && !/^[0-9]+$/.test(lengthValue)) malformed();
+  const length = lengthValue === undefined ? 0 : Number(lengthValue);
+  if (!Number.isSafeInteger(length) || length > MAX_BODY_BYTES) malformed();
+  if (bytes.length < bodyStart + length) return null;
+  return {
+    method: match[1],
+    path: match[2],
+    headers,
+    body: bytes.subarray(bodyStart, bodyStart + length),
+  };
+};
+
+module.exports = { parseRequest };
