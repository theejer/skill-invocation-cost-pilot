diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..dc1bc86
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,73 @@
+const { test, after } = require('node:test');
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { parseRequest } = require('../request');
+
+process.env.PORT = '0';
+const server = require('../server');
+const ready = once(server, 'listening');
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const exchange = async (request) => {
+  await ready;
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.on('data', (chunk) => { response += chunk; });
+  const ended = once(socket, 'end');
+  socket.end(request);
+  await ended;
+  return response;
+};
+
+test('parses headers and a binary body across every possible split', () => {
+  const head = Buffer.from('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\n');
+  const bytes = Buffer.concat([head, Buffer.from([0, 128, 255])]);
+  for (let i = 0; i < bytes.length; i++) {
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([0, 128, 255]));
+});
+
+test('echo and existing routes', async () => {
+  assert.match(await exchange('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc'), /200 OK[\s\S]*\r\n\r\nPOST \/echo$/);
+  assert.match(await exchange('GET / HTTP/1.1\r\n\r\n'), /200 OK/);
+  assert.match(await exchange('GET /users/12/posts/34 HTTP/1.1\r\n\r\n'), /\r\n\r\n12 34$/);
+  assert.match(await exchange('POST / HTTP/1.1\r\n\r\n'), /405 Method Not Allowed/);
+  assert.match(await exchange('GET /missing HTTP/1.1\r\n\r\n'), /404 Not Found/);
+});
+
+test('malformed and truncated requests receive 400', async () => {
+  for (const request of [
+    'GET /echo garbage\r\n\r\n',
+    'GET  /echo HTTP/1.1\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 3x\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc',
+    'GET /echo HTTP/1.1\r\n',
+    'x'.repeat(8192),
+  ]) assert.match(await exchange(request), /400 Bad Request/);
+});
+
+test('server waits for the declared body before replying', async () => {
+  await ready;
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk.toString(); });
+  const ended = once(socket, 'end');
+  socket.write('PUT /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 40));
+  assert.equal(response, '');
+  socket.end('cd');
+  await ended;
+  assert.match(response, /\r\n\r\nPUT \/echo$/);
+});
