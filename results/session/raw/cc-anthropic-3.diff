new file mode 100644
index 0000000..02467d7
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,66 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+const HEADERS_END = '\r\n\r\n';
+
+const INCOMPLETE = { status: 'incomplete' };
+const BAD = { status: 'bad' };
+
+const parseContentLength = (headers) => {
+  if (headers.has('transfer-encoding')) return null;
+  const values = headers.get('content-length');
+  if (!values) return 0;
+  if (new Set(values).size !== 1 || !CONTENT_LENGTH_PATTERN.test(values[0])) return null;
+  const contentLength = Number(values[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+
+  const headers = new Map();
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    headers.set(name, [...(headers.get(name) ?? []), headerMatch[2]]);
+  }
+
+  const contentLength = parseContentLength(headers);
+  if (contentLength === null) return null;
+
+  const [, method, target] = requestLineMatch;
+  return { method, target, headers, contentLength };
+};
+
+// Returns { status: 'incomplete' | 'bad' | 'too-large' | 'ok', request? } for the bytes received so far.
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? BAD : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEADERS_END);
+  if (headEnd === -1) {
+    return receivedBytes.length >= maxHeaderBytes ? BAD : INCOMPLETE;
+  }
+
+  const head = parseHead(receivedBytes.toString('latin1', 0, headEnd));
+  if (!head) return BAD;
+  if (head.contentLength > maxBodyBytes) return { status: 'too-large' };
+
+  const bodyStart = headEnd + HEADERS_END.length;
+  const bodyEnd = bodyStart + head.contentLength;
+  if (receivedBytes.length < bodyEnd) return INCOMPLETE;
+
+  const { method, target, headers } = head;
+  return {
+    status: 'ok',
+    request: { method, target, headers, body: receivedBytes.subarray(bodyStart, bodyEnd) },
+  };
+};
+
+module.exports = { parseRequest };
