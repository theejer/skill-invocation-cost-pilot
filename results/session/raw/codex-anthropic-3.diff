@@ -0,0 +1,78 @@
+﻿const {
+  BAD_REQUEST_RESPONSE,
+  PAYLOAD_TOO_LARGE_RESPONSE,
+} = require('./router');
+
+const CRLF = '\r\n';
+const HEAD_END = '\r\n\r\n';
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) ([^\x00-\x20\x7f]+) HTTP\/\d\.\d$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const HEADER_VALUE_PATTERN = /^[\t\x20-\x7e\x80-\xff]*$/;
+const DIGITS_PATTERN = /^\d+$/;
+
+const INCOMPLETE = { type: 'incomplete' };
+const BAD_REQUEST = { type: 'error', response: BAD_REQUEST_RESPONSE };
+const PAYLOAD_TOO_LARGE = { type: 'error', response: PAYLOAD_TOO_LARGE_RESPONSE };
+
+const parseHeaders = (headerLines) => {
+  const headers = new Map();
+  for (const line of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(line);
+    if (!headerMatch || !HEADER_VALUE_PATTERN.test(headerMatch[2])) return null;
+
+    const name = headerMatch[1].toLowerCase();
+    const values = headers.get(name) ?? [];
+    values.push(headerMatch[2]);
+    headers.set(name, values);
+  }
+  return headers;
+};
+
+const readContentLength = (headers) => {
+  const values = headers.get('content-length');
+  if (!values) return 0;
+  if (!values.every((value) => DIGITS_PATTERN.test(value) && value === values[0])) return null;
+
+  const contentLength = Number(values[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes
+    .subarray(0, maxRequestLineBytes)
+    .indexOf(CRLF);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    return receivedBytes.length >= maxHeaderBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const [requestLine, ...headerLines] = receivedBytes.toString('latin1', 0, headEnd).split(CRLF);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  const headers = parseHeaders(headerLines);
+  if (!requestLineMatch || !headers || headers.has('transfer-encoding')) return BAD_REQUEST;
+
+  const contentLength = readContentLength(headers);
+  if (contentLength === null) return BAD_REQUEST;
+  if (contentLength > maxBodyBytes) return PAYLOAD_TOO_LARGE;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  const bodyEnd = bodyStart + contentLength;
+  if (receivedBytes.length < bodyEnd) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    type: 'request',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.toString('latin1', bodyStart, bodyEnd),
+    },
+  };
+};
+
+module.exports = { parseRequest };
