index 0cd6db5..1c99753 100644
--- a/README.md
+++ b/README.md
@@ -1,4 +1,11 @@
-An HTTP server that routes each request by the method and target in its request line.
+An HTTP server that parses each request (request line, headers and any `Content-Length` body) and routes it by method and target.
+
+Routes:
+- `GET /` returns 200.
+- `GET /users/:userId/posts/:postId` returns `userId postId`.
+- `/echo` (any method, query string ignored) returns `METHOD /path`.
+
+Malformed requests (bad request line, bad headers, invalid `Content-Length`, `Transfer-Encoding`, oversized request line or headers, or a connection closed before the full request arrives) get `400 Bad Request`. A body over `MAX_BODY_BYTES` gets `413`.
 
 Run: `node server.js`
 
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..890e16c
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,36 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const INVALID_HEADER_VALUE_PATTERN = /[\x00-\x08\x0a-\x1f\x7f]/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+
+const parseContentLength = (headerValue) => {
+  if (headerValue === undefined) return 0;
+  const lengths = headerValue.split(',').map((length) => length.trim());
+  if (!lengths.every((length) => CONTENT_LENGTH_PATTERN.test(length))) return null;
+  if (new Set(lengths).size !== 1) return null;
+  const contentLength = Number(lengths[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+const parseRequestHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+
+  const headers = {};
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch || INVALID_HEADER_VALUE_PATTERN.test(headerMatch[2])) return null;
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  if ('transfer-encoding' in headers) return null;
+  const contentLength = parseContentLength(headers['content-length']);
+  if (contentLength === null) return null;
+
+  const [, method, target] = requestLineMatch;
+  return { method, target, headers, contentLength };
+};
+
+module.exports = { parseRequestHead };
