new file mode 100644
index 0000000..5a9fd2a
--- /dev/null
+++ b/request.js
@@ -0,0 +1,51 @@
+const TOKEN_PATTERN = /^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/;
+const REQUEST_LINE_PATTERN = /^([^ ]+) (\/[^\s\x00-\x1f\x7f]*|\*) HTTP\/1\.[01]$/;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE_PATTERN.exec(line);
+  if (!match || !TOKEN_PATTERN.test(match[1])) throw new Error('Invalid request line');
+  return { method: match[1], path: match[2] };
+};
+
+// Returns null until the complete request is available. Lengths are byte counts.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headersEnd = bytes.indexOf('\r\n\r\n');
+  if (headersEnd === -1) {
+    if (bytes.length > 65536) throw new Error('Headers too long');
+    return null;
+  }
+  if (headersEnd + 4 > 65536) throw new Error('Headers too long');
+
+  const headers = Object.create(null);
+  const headerText = bytes.toString('latin1', lineEnd + 2, headersEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon <= 0 || !TOKEN_PATTERN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value.trim() : `${headers[key]}, ${value.trim()}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^\d+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headersEnd + 4;
+  if (bytes.length - bodyStart < Number(length)) return null;
+  return { ...request, headers, body: bytes.subarray(bodyStart, bodyStart + Number(length)) };
+};
+
+module.exports = { parseRequestLine, parseRequest };
