diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..b0488fc
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,73 @@
+const { test, after } = require('node:test');
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { parseRequestHead } = require('../request');
+
+process.env.PORT = '0';
+const server = require('../server');
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const exchange = async (chunks) => {
+  if (!server.listening) await once(server, 'listening');
+  const socket = net.createConnection(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.on('data', (chunk) => { response += chunk; });
+  const ended = once(socket, 'end');
+  await once(socket, 'connect');
+  for (const chunk of chunks) socket.write(chunk);
+  socket.end();
+  await ended;
+  return response;
+};
+
+test('parses request line, case-insensitive headers and byte length', () => {
+  const request = parseRequestHead('POST /echo HTTP/1.1\r\nContent-Length: 3\r\nX-Test: value');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.equal(request.contentLength, 3);
+});
+
+test('echo accepts a body split across writes', async () => {
+  const response = await exchange(['POST /echo HTTP/1.1\r\nContent-Len', 'gth: 3\r\n\r\n', Buffer.from([0, 255, 1])]);
+  assert.match(response, /^HTTP\/1.1 200 OK\r\n/);
+  assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('preserves existing routes', async () => {
+  assert.match(await exchange(['GET / HTTP/1.1\r\n\r\n']), /^HTTP\/1.1 200/);
+  assert.ok((await exchange(['GET /users/7/posts/9 HTTP/1.1\r\n\r\n'])).endsWith('7 9'));
+  assert.match(await exchange(['POST / HTTP/1.1\r\n\r\n']), /^HTTP\/1.1 405/);
+  assert.match(await exchange(['GET /missing HTTP/1.1\r\n\r\n']), /^HTTP\/1.1 404/);
+});
+
+test('rejects malformed and truncated requests', async () => {
+  for (const request of [
+    'GET /echo garbage\r\n\r\n',
+    'GET  /echo HTTP/1.1\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBad Header: value\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+    'GET /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc',
+    'GET /echo HTTP/1.1\r\n',
+  ]) {
+    assert.match(await exchange([request]), /^HTTP\/1.1 400 Bad Request\r\n/, request);
+  }
+});
+
+test('does not respond until the complete body arrives', async () => {
+  const socket = net.createConnection(server.address().port, '127.0.0.1');
+  await once(socket, 'connect');
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk.toString(); });
+  const ended = once(socket, 'end');
+  socket.write('POST /echo HTTP/1.1\r\nContent-Length: 2\r\n\r\na');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(response, '');
+  socket.write('b');
+  await ended;
+  assert.match(response, /^HTTP\/1.1 200/);
+});
