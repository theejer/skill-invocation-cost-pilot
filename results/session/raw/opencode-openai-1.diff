diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..97752b0
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,69 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { parseRequest } = require('../request');
+const { routeRequest, routeRequestLine } = require('../router');
+
+test('parses request line, case-insensitive headers and binary body', () => {
+  const body = Buffer.from([0, 255, 13, 10]);
+  const bytes = Buffer.concat([
+    Buffer.from('POST /echo HTTP/1.1\r\nCoNtEnT-LeNgTh: 4\r\nX-Test: value\t \r\n\r\n'),
+    body,
+  ]);
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers['content-length'], '4');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.deepEqual(request.body, body);
+  for (let length = 0; length < bytes.length; length++) {
+    assert.equal(parseRequest(bytes.subarray(0, length)), null);
+  }
+});
+
+test('supports empty bodies and does not consume bytes beyond Content-Length', () => {
+  assert.equal(parseRequest(Buffer.from('GET / HTTP/1.0\r\n\r\n')).body.length, 0);
+  const request = parseRequest(Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcEXTRA'));
+  assert.equal(request.body.toString(), 'abc');
+});
+
+test('rejects malformed request lines, headers and body framing', () => {
+  const invalid = [
+    'GET / HTTP/2.0\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GE(T / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\n\r\n\r\n',
+    'GET / HTTP/1.1\n\n',
+    'GET / HTTP/1.1\r\nNo-Colon\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nName\n: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nName: bad\x00value\r\n\r\n',
+    'GET / HTTP/1.1\r\n folded: value\r\n\r\n',
+    ...['-1', '+1', '1.5', 'abc', '', '1, 1', '9007199254740992'].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\na',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ];
+  for (const request of invalid) assert.throws(() => parseRequest(Buffer.from(request)), request);
+});
+
+test('enforces request line and header size limits', () => {
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 15));
+  assert.throws(() => parseRequest(Buffer.from('G'.repeat(8192))));
+  assert.throws(() => parseRequest(Buffer.from(`GET / HTTP/1.1\r\nX: ${'a'.repeat(65536)}`)));
+});
+
+test('echo supports all methods and existing routes keep their responses', () => {
+  for (const method of ['GET', 'POST', 'PUT', 'DELETE']) {
+    const response = routeRequest({ method, path: '/echo' });
+    assert.ok(response.startsWith('HTTP/1.1 200 OK\r\n'));
+    assert.ok(response.endsWith(`\r\n\r\n${method} /echo`));
+    assert.ok(response.includes(`Content-Length: ${method.length + 6}\r\n`));
+  }
+  assert.match(routeRequestLine('GET / HTTP/1.1'), /^HTTP\/1.1 200 OK/);
+  assert.ok(routeRequestLine('GET /users/12/posts/34 HTTP/1.1').endsWith('\r\n\r\n12 34'));
+  assert.match(routeRequestLine('POST / HTTP/1.1'), /^HTTP\/1.1 405 Method Not Allowed/);
+  assert.match(routeRequestLine('GET /missing HTTP/1.1'), /^HTTP\/1.1 404 Not Found/);
+  assert.match(routeRequestLine('nonsense'), /^HTTP\/1.1 400 Bad Request/);
+});
diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..411ba36
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,55 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { test } = require('node:test');
+const { createServer } = require('../server');
+
+const startServer = async (t) => {
+  const server = createServer();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  return server.address().port;
+};
+
+const exchange = (port, request) => new Promise((resolve, reject) => {
+  const socket = net.createConnection({ port, host: '127.0.0.1' });
+  const chunks = [];
+  socket.on('error', reject);
+  socket.on('data', (chunk) => chunks.push(chunk));
+  socket.on('end', () => resolve(Buffer.concat(chunks).toString('latin1')));
+  socket.on('connect', () => socket.end(request));
+});
+
+test('server waits for complete headers and Content-Length body', { timeout: 5000 }, async (t) => {
+  const port = await startServer(t);
+  const socket = net.createConnection({ port, host: '127.0.0.1' });
+  t.after(() => socket.destroy());
+  await once(socket, 'connect');
+  const chunks = [];
+  socket.on('data', (chunk) => chunks.push(chunk));
+  const ended = once(socket, 'end');
+  socket.write('POST /echo HTTP/1.1\r\n');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(chunks.length, 0);
+  socket.write('Content-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(chunks.length, 0);
+  socket.write('cd');
+  await ended;
+  assert.ok(Buffer.concat(chunks).toString().endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('server returns 400 for malformed and truncated requests', { timeout: 5000 }, async (t) => {
+  const port = await startServer(t);
+  for (const request of [
+    'bad request\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBad header\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nContent-Length: nope\r\n\r\n',
+    'GET /echo HTTP/1.1\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab',
+    '',
+  ]) {
+    assert.match(await exchange(port, request), /^HTTP\/1.1 400 Bad Request\r\n/);
+  }
+});
