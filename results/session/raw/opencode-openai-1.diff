diff --git a/request.js b/request.js
new file mode 100644
index 0000000..09535c2
--- /dev/null
+++ b/request.js
@@ -0,0 +1,36 @@
+const TOKEN_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\s\x00-\x20\x7f]*|\*) HTTP\/(1\.[01])$/;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE_PATTERN.exec(line);
+  if (!match) throw new Error('Invalid request line');
+  const [, method, path, version] = match;
+  return { method, path, version };
+};
+
+const parseRequestHead = (head) => {
+  const [line, ...lines] = head.split('\r\n');
+  const request = parseRequestLine(line);
+  const headers = Object.create(null);
+  for (const header of lines) {
+    const colon = header.indexOf(':');
+    const name = header.slice(0, colon);
+    const value = header.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN_PATTERN.test(name) || /[^\t\x20-\x7e\x80-\xff]/.test(header.slice(colon + 1))) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'];
+  if (length !== undefined && !/^\d+$/.test(length)) throw new Error('Invalid Content-Length');
+  const contentLength = length === undefined ? 0 : Number(length);
+  if (!Number.isSafeInteger(contentLength)) throw new Error('Invalid Content-Length');
+  return { ...request, headers, contentLength };
+};
+
+module.exports = { parseRequestLine, parseRequestHead };
