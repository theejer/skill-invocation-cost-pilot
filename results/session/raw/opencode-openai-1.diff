diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..55d5b6d
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,84 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const { once } = require('node:events');
+const { parseRequest } = require('../request');
+const { routeRequest } = require('../router');
+
+test('parses headers and a byte-counted body only when complete', () => {
+  const head = Buffer.from('POST /echo HTTP/1.1\r\nX-Test: value\r\ncontent-length: 3\r\n\r\n');
+  const bytes = Buffer.concat([head, Buffer.from('é!')]);
+  for (let i = 0; i < bytes.length; i++) {
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.equal(request.body.toString(), 'é!');
+  assert.ok(routeRequest(request).endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('accepts requests without headers or a body and preserves routes', () => {
+  for (const [path, status, body] of [
+    ['/', '200 OK', ''],
+    ['/users/12/posts/34', '200 OK', '12 34'],
+    ['/missing', '404 Not Found', ''],
+  ]) {
+    const request = parseRequest(Buffer.from(`GET ${path} HTTP/1.1\r\n\r\n`));
+    assert.equal(request.body.length, 0);
+    const response = routeRequest(request);
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}`));
+    assert.ok(response.endsWith(`\r\n\r\n${body}`));
+  }
+  assert.match(routeRequest({ method: 'POST', path: '/' }), /405 Method Not Allowed/);
+});
+
+test('rejects malformed request lines, headers, and body framing', () => {
+  for (const request of [
+    'GET / WHAT\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nName : value\r\n\r\n',
+    'GET / HTTP/1.1\r\nX: bad\x00value\r\n\r\n',
+    ...['-1', '1.5', 'abc', '9007199254740992', ''].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parseRequest(Buffer.from(request)));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+});
+
+test('server handles fragmented requests and rejects incomplete requests at EOF', async (t) => {
+  const child = spawn(process.execPath, ['-e', `
+    const net = require('net');
+    const listen = net.Server.prototype.listen;
+    net.Server.prototype.listen = function (...args) {
+      this.on('listening', () => console.log(this.address().port));
+      return listen.apply(this, args);
+    };
+    require('./server');
+  `], { cwd: require('node:path').resolve(__dirname, '..'), env: { ...process.env, PORT: '0' } });
+  t.after(() => child.kill());
+  const [output] = await once(child.stdout, 'data');
+  const port = Number(output.toString().trim());
+  const exchange = async (parts) => {
+    const socket = net.createConnection({ port });
+    socket.setTimeout(3000, () => socket.destroy(new Error('Request timed out')));
+    let response = '';
+    socket.on('data', (chunk) => { response += chunk.toString(); });
+    const ended = once(socket, 'end');
+    await once(socket, 'connect');
+    for (const part of parts) socket.write(part);
+    socket.end();
+    await ended;
+    return response;
+  };
+  assert.ok((await exchange(['POST /echo HTTP/1.1\r', '\nContent-Length: 4\r\n\r\n', 'te', 'st']))
+    .endsWith('\r\n\r\nPOST /echo'));
+  for (const request of ['GET / HTTP/1.1\r\n', 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nx', 'bad\r\n\r\n']) {
+    assert.match(await exchange([request]), /^HTTP\/1\.1 400 Bad Request/);
+  }
+});
