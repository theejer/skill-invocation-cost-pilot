@@ -0,0 +1,70 @@
+const TOKEN_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$(?![\s\S])/;
+const REQUEST_LINE_PATTERN = /^([^ ]+) (\/[^\x00-\x20\x7f-\xff#]*) (HTTP\/1\.[01])$(?![\s\S])/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (requestLine) => {
+  const match = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!match || !TOKEN_PATTERN.test(match[1])) throw new Error('Invalid request line');
+  const [, method, path, version] = match;
+  return { method, path, version };
+};
+
+// Return null until the entire request has arrived. Framing errors throw.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.includes(10) || bytes.length >= maxRequestLineBytes) {
+      throw new Error('Invalid or oversized request line');
+    }
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Oversized request line');
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headers = Object.create(null);
+  const headerStart = lineEnd + 2;
+  let offset = headerStart;
+
+  while (true) {
+    const end = bytes.indexOf('\r\n', offset);
+    if (end === -1) {
+      if (bytes.subarray(offset).includes(10) || bytes.length - headerStart >= MAX_HEADER_BYTES) {
+        throw new Error('Invalid or oversized headers');
+      }
+      return null;
+    }
+    if (end + 2 - headerStart > MAX_HEADER_BYTES) throw new Error('Oversized headers');
+    if (end === offset) {
+      offset += 2;
+      break;
+    }
+    const line = bytes.toString('latin1', offset, end);
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon <= 0 || !TOKEN_PATTERN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    const trimmedValue = value.replace(/^[ \t]+|[ \t]+$/g, '');
+    headers[key] = headers[key] === undefined ? trimmedValue : `${headers[key]}, ${trimmedValue}`;
+    offset = end + 2;
+  }
+
+  // Chunked framing is not supported; never mistake it for an empty body.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const lengthHeader = headers['content-length'];
+  if (lengthHeader !== undefined && !/^[0-9]+$/.test(lengthHeader)) {
+    throw new Error('Invalid Content-Length');
+  }
+  const contentLength = lengthHeader === undefined ? 0 : Number(lengthHeader);
+  if (!Number.isSafeInteger(contentLength) || !Number.isSafeInteger(offset + contentLength)) {
+    throw new Error('Invalid Content-Length');
+  }
+  if (bytes.length - offset < contentLength) return null;
+  return { ...request, headers, body: bytes.subarray(offset, offset + contentLength) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
