new file mode 100644
index 0000000..e284369
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,32 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +(HTTP\/\d\.\d)$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+
+// Parses a request head (everything before the blank line).
+// Returns { method, target, version, headers, contentLength } or null if malformed.
+const parseHead = (head) => {
+  const lines = head.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(lines[0]);
+  if (!requestLineMatch) return null;
+  const [, method, target, version] = requestLineMatch;
+
+  const headers = {};
+  for (const line of lines.slice(1)) {
+    const headerMatch = HEADER_PATTERN.exec(line);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    const values = headers['content-length'].split(',').map((v) => v.trim());
+    if (new Set(values).size !== 1 || !CONTENT_LENGTH_PATTERN.test(values[0])) return null;
+    contentLength = Number(values[0]);
+    if (!Number.isSafeInteger(contentLength)) return null;
+  }
+
+  return { method, target, version, headers, contentLength };
+};
+
+module.exports = { parseHead };
