diff --git a/request.js b/request.js
new file mode 100644
index 0000000..e068d97
--- /dev/null
+++ b/request.js
@@ -0,0 +1,63 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const HEADER_END = '\r\n\r\n';
+
+class BadRequestError extends Error {}
+
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) throw new BadRequestError('malformed request line');
+
+  const headers = {};
+  for (const line of headerLines) {
+    const headerMatch = HEADER_PATTERN.exec(line);
+    if (!headerMatch) throw new BadRequestError('malformed header');
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  return { method: requestLineMatch[1], target: requestLineMatch[2], headers };
+};
+
+const readContentLength = (headers, maxBodyBytes) => {
+  if (!('content-length' in headers)) return 0;
+  const values = headers['content-length'].split(',').map((value) => value.trim());
+  if (!values.every((value) => CONTENT_LENGTH_PATTERN.test(value) && value === values[0])) {
+    throw new BadRequestError('invalid Content-Length');
+  }
+  const contentLength = Number(values[0]);
+  if (!Number.isSafeInteger(contentLength) || contentLength > maxBodyBytes) {
+    throw new BadRequestError('Content-Length too large');
+  }
+  return contentLength;
+};
+
+// Returns null if more bytes are needed, otherwise { request }.
+// Throws BadRequestError if the bytes received so far cannot be a valid request.
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf('\r\n');
+  if (requestLineEnd === -1 && receivedBytes.length >= maxRequestLineBytes) {
+    throw new BadRequestError('request line too long');
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEADER_END);
+  if (headEnd === -1) {
+    if (receivedBytes.length >= maxHeaderBytes) throw new BadRequestError('headers too large');
+    return null;
+  }
+  if (requestLineEnd === -1 || requestLineEnd > maxRequestLineBytes) {
+    throw new BadRequestError('request line too long');
+  }
+
+  const { method, target, headers } = parseHead(receivedBytes.toString('latin1', 0, headEnd));
+  const contentLength = readContentLength(headers, maxBodyBytes);
+  const bodyStart = headEnd + HEADER_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return null;
+
+  const body = receivedBytes.subarray(bodyStart, bodyStart + contentLength);
+  return { request: { method, target, headers, body } };
+};
+
+module.exports = { BadRequestError, parseRequest };
