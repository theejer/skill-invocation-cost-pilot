diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..7901ef0
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,60 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const HEAD_END = '\r\n\r\n';
+const LINE_END = '\r\n';
+
+const INCOMPLETE = { status: 'incomplete' };
+const BAD = { status: 'bad' };
+
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+
+  const headers = {};
+  for (const line of headerLines) {
+    const headerMatch = HEADER_PATTERN.exec(line);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  const [, method, target] = requestLineMatch;
+  return { method, target, headers };
+};
+
+const parseContentLength = (headers, maxBodyBytes) => {
+  if (!('content-length' in headers)) return 0;
+  const value = headers['content-length'];
+  if (!CONTENT_LENGTH_PATTERN.test(value)) return null;
+  const length = Number(value);
+  return Number.isSafeInteger(length) && length <= maxBodyBytes ? length : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeadBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes
+    .subarray(0, maxRequestLineBytes)
+    .indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? BAD : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.indexOf(HEAD_END);
+  if (headEnd === -1) return receivedBytes.length >= maxHeadBytes ? BAD : INCOMPLETE;
+  if (headEnd > maxHeadBytes) return BAD;
+
+  const request = parseHead(receivedBytes.toString('latin1', 0, headEnd));
+  if (!request) return BAD;
+
+  const contentLength = parseContentLength(request.headers, maxBodyBytes);
+  if (contentLength === null) return BAD;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return INCOMPLETE;
+
+  request.body = receivedBytes.toString('latin1', bodyStart, bodyStart + contentLength);
+  return { status: 'complete', request };
+};
+
+module.exports = { parseRequest };
