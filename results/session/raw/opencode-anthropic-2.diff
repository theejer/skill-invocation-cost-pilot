@@ -5,3 +5,13 @@ Run: `node server.js`
 Minimum Node.js version: 22
 
 Port: 8080
+
+
+Requests are parsed in full: request line, headers and any `Content-Length` body. Malformed requests get `400 Bad Request`.
+
+Routes:
+- `GET /`: 200
+- `GET /users/:userId/posts/:postId`: 200, body `userId postId`
+- any method on `/echo`: 200, body `METHOD /echo`
+
+Limits (environment variables): `MAX_REQUEST_LINE_BYTES` (8192), `MAX_HEADER_BYTES` (16384), `MAX_BODY_BYTES` (1048576, larger bodies get `413`).
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..b50c465
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,73 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const HEADER_VALUE_FORBIDDEN_PATTERN = /[\x00-\x08\x0a-\x1f\x7f]/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+const HEAD_END = '\r\n\r\n';
+
+const INCOMPLETE = { state: 'incomplete' };
+const INVALID = { state: 'invalid' };
+const TOO_LARGE = { state: 'too_large' };
+
+const parseHeaders = (headerLines) => {
+  const headers = new Map();
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch || HEADER_VALUE_FORBIDDEN_PATTERN.test(headerMatch[2])) return null;
+
+    const name = headerMatch[1].toLowerCase();
+    const value = headerMatch[2];
+    headers.set(name, headers.has(name) ? `${headers.get(name)}, ${value}` : value);
+  }
+  return headers;
+};
+
+const parseContentLength = (headers) => {
+  if (!headers.has('content-length')) return 0;
+
+  const values = headers.get('content-length').split(',').map((value) => value.trim());
+  if (!values.every((value) => CONTENT_LENGTH_PATTERN.test(value) && value === values[0])) {
+    return null;
+  }
+  const contentLength = Number(values[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? INVALID : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    return receivedBytes.length >= maxHeaderBytes ? INVALID : INCOMPLETE;
+  }
+
+  const [requestLine, ...headerLines] = receivedBytes.toString('latin1', 0, headEnd).split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return INVALID;
+
+  const headers = parseHeaders(headerLines);
+  if (!headers || headers.has('transfer-encoding')) return INVALID;
+
+  const contentLength = parseContentLength(headers);
+  if (contentLength === null) return INVALID;
+  if (contentLength > maxBodyBytes) return TOO_LARGE;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length - bodyStart < contentLength) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    state: 'complete',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
