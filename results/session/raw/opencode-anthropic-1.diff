diff --git a/request.js b/request.js
new file mode 100644
index 0000000..262ff67
--- /dev/null
+++ b/request.js
@@ -0,0 +1,39 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const HEADER_END = '\r\n\r\n';
+
+// Parses the request line and headers (the text before the blank line).
+// Returns { request } with method, target, headers (lowercased names) and
+// contentLength, or { error: true } if the head is malformed.
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return { error: true };
+
+  const headers = {};
+  for (const line of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(line);
+    if (!headerMatch) return { error: true };
+    const name = headerMatch[1].toLowerCase();
+    const value = headerMatch[2];
+    if (name === 'content-length' && name in headers && headers[name] !== value) {
+      return { error: true };
+    }
+    headers[name] = name in headers && name !== 'content-length' ? `${headers[name]}, ${value}` : value;
+  }
+
+  if ('transfer-encoding' in headers) return { error: true };
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    if (!CONTENT_LENGTH_PATTERN.test(headers['content-length'])) return { error: true };
+    contentLength = Number(headers['content-length']);
+    if (!Number.isSafeInteger(contentLength)) return { error: true };
+  }
+
+  const [, method, target] = requestLineMatch;
+  return { request: { method, target, headers, contentLength } };
+};
+
+module.exports = { HEADER_END, parseHead };
