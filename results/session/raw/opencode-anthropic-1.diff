index 0cd6db5..a5f603c 100644
--- a/README.md
+++ b/README.md
@@ -1,5 +1,7 @@
 An HTTP server that routes each request by the method and target in its request line.
 
+Each request's request line, headers and `Content-Length` body are parsed before routing. Malformed requests get `400 Bad Request` (bodies over 1 MiB get `413`). `/echo` replies with the request's method and path, e.g. `POST /echo`.
+
 Run: `node server.js`
 
 Minimum Node.js version: 22
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..44274ac
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,37 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const FORBIDDEN_CHARACTERS_PATTERN = /[\0\r\n]/;
+
+// Parses the request line and headers (everything before the blank line).
+// Returns null when the head is malformed.
+const parseRequestHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  if (FORBIDDEN_CHARACTERS_PATTERN.test(requestLine)) return null;
+
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+  const [, method, target] = requestLineMatch;
+
+  const headers = new Map();
+  for (const headerLine of headerLines) {
+    if (FORBIDDEN_CHARACTERS_PATTERN.test(headerLine)) return null;
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+
+    const name = headerMatch[1].toLowerCase();
+    const value = headerMatch[2];
+    headers.set(name, headers.has(name) ? `${headers.get(name)}, ${value}` : value);
+  }
+
+  let contentLength = 0;
+  if (headers.has('content-length')) {
+    const rawContentLength = headers.get('content-length');
+    if (!CONTENT_LENGTH_PATTERN.test(rawContentLength)) return null;
+    contentLength = Number(rawContentLength);
+  }
+
+  return { method, target, headers, contentLength };
+};
+
+module.exports = { parseRequestHead };
