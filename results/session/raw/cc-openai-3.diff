diff --git a/request.js b/request.js
new file mode 100644
index 0000000..9331f62
--- /dev/null
+++ b/request.js
@@ -0,0 +1,54 @@
+const TOKEN_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE_PATTERN = /^([^ ]+) (\/[^\s\x00-\x1f\x7f]*|\*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (requestLine) => {
+  const match = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!match || !TOKEN_PATTERN.test(match[1])) throw new Error('Invalid request line');
+  return { method: match[1], path: match[2] };
+};
+
+const parseRequest = (receivedBytes, maxRequestLineBytes = 8192) => {
+  const requestLineEnd = receivedBytes.indexOf('\r\n');
+  if (requestLineEnd === -1) {
+    if (receivedBytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (requestLineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const request = parseRequestLine(receivedBytes.toString('latin1', 0, requestLineEnd));
+
+  const headersEnd = receivedBytes.indexOf('\r\n\r\n');
+  if (headersEnd === -1) {
+    if (receivedBytes.length > MAX_HEADER_BYTES) throw new Error('Headers too long');
+    return null;
+  }
+  const bodyStart = headersEnd + 4;
+  if (bodyStart > MAX_HEADER_BYTES) throw new Error('Headers too long');
+
+  const headers = Object.create(null);
+  const headerLines = receivedBytes.toString('latin1', requestLineEnd + 2, headersEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon < 1 || !TOKEN_PATTERN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value.trim() : `${headers[key]}, ${value.trim()}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+
+  const length = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyLength = Number(length);
+  if (receivedBytes.length - bodyStart < bodyLength) return null;
+  return { ...request, headers, body: receivedBytes.subarray(bodyStart, bodyStart + bodyLength) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..86a8c49
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,98 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const { once } = require('node:events');
+const { parseRequest } = require('./request');
+const { routeRequest } = require('./router');
+
+const parse = (text, limit) => parseRequest(Buffer.from(text, 'utf8'), limit);
+
+test('parses request line, case-insensitive headers and byte-counted body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 2\r\n\r\néextra');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.body.toString(), 'é');
+  assert.match(routeRequest(request), /\r\n\r\nPOST \/echo$/);
+});
+
+test('waits for complete headers and body across every byte boundary', () => {
+  const bytes = Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ndata');
+  for (let i = 0; i < bytes.length; i++) {
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+  }
+  assert.equal(parseRequest(bytes).body.toString(), 'data');
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed request lines, headers and body lengths', () => {
+  for (const text of [
+    'GET / nonsense\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'G(ET / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nNoColon\r\n\r\n',
+    'GET / HTTP/1.1\r\nHost : localhost\r\n\r\n',
+    'GET / HTTP/1.1\r\nHost: a\nb\r\n\r\n',
+    ...['-1', '1x', '', '9007199254740992'].map((length) =>
+      `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\nx',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parse(text), Error, text);
+  assert.throws(() => parse('GET / HTTP/1.1\r\n\r\n', 8));
+});
+
+test('preserves existing routes', () => {
+  for (const [method, path, status, body] of [
+    ['GET', '/', '200 OK', ''],
+    ['GET', '/users/alex/posts/42', '200 OK', 'alex 42'],
+    ['POST', '/', '405 Method Not Allowed', ''],
+    ['GET', '/missing', '404 Not Found', ''],
+  ]) {
+    const response = routeRequest({ method, path });
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}\r\n`));
+    assert.equal(response.split('\r\n\r\n')[1], body);
+  }
+});
+
+test('server returns echo and 400 for truncated or malformed requests', async (t) => {
+  const reservation = net.createServer();
+  reservation.listen(0, '127.0.0.1');
+  await once(reservation, 'listening');
+  const port = reservation.address().port;
+  await new Promise((resolve) => reservation.close(resolve));
+  const child = spawn(process.execPath, ['server.js'], {
+    cwd: __dirname,
+    env: { ...process.env, PORT: String(port) },
+    stdio: 'pipe',
+  });
+  t.after(() => child.kill());
+  const connect = () => new Promise((resolve, reject) => {
+    const socket = net.connect(port, '127.0.0.1');
+    socket.once('connect', () => resolve(socket));
+    socket.once('error', reject);
+  });
+  let socket;
+  for (let attempt = 0; attempt < 100; attempt++) {
+    try { socket = await connect(); break; } catch (error) {
+      if (attempt === 99) throw error;
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+  }
+  socket.destroy();
+  for (const [request, expected] of [
+    ['POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ndata', '200 OK'],
+    ['GET / HTTP/1.1\r\nBadHeader\r\n\r\n', '400 Bad Request'],
+    ['POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nx', '400 Bad Request'],
+    ['GET / HTTP/1.1\r\n', '400 Bad Request'],
+  ]) {
+    const conn = await connect();
+    conn.setTimeout(2000, () => conn.destroy(new Error('Response timeout')));
+    let response = '';
+    conn.on('data', (chunk) => { response += chunk.toString('latin1'); });
+    conn.end(request);
+    await once(conn, 'end');
+    assert.ok(response.startsWith(`HTTP/1.1 ${expected}\r\n`), response);
+    if (expected === '200 OK') assert.ok(response.endsWith('POST /echo'));
+  }
+});
