diff --git a/request.js b/request.js
new file mode 100644
index 0000000..9abb5dd
--- /dev/null
+++ b/request.js
@@ -0,0 +1,73 @@
+const DEFAULT_MAX_REQUEST_LINE_BYTES = 8192;
+const MAX_HEADER_BYTES = 65536;
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+\-.^_`|~0-9A-Za-z]+) (\/[^\x00-\x20\x7f]*) (HTTP\/1\.[01])$/;
+const INVALID_HEADER_NAME_PATTERN = /[^!#$%&'*+\-.^_`|~0-9A-Za-z]/;
+const INVALID_HEADER_VALUE_PATTERN = /[\x00-\x08\x0a-\x1f\x7f]/;
+
+class BadRequestError extends Error {}
+
+const parseRequest = (receivedBytes, maxRequestLineBytes = DEFAULT_MAX_REQUEST_LINE_BYTES) => {
+  const requestLineEnd = receivedBytes.indexOf('\r\n');
+  if (requestLineEnd === -1) {
+    if (receivedBytes.length >= maxRequestLineBytes) throw new BadRequestError('Request line too long');
+    return null;
+  }
+  if (requestLineEnd + 2 > maxRequestLineBytes) throw new BadRequestError('Request line too long');
+
+  const requestLine = receivedBytes.toString('latin1', 0, requestLineEnd);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch || requestLineMatch[0] !== requestLine) throw new BadRequestError('Invalid request line');
+
+  const headerStart = requestLineEnd + 2;
+  const headerEnd = receivedBytes.indexOf('\r\n\r\n', requestLineEnd);
+  if (headerEnd === -1) {
+    if (receivedBytes.length - headerStart > MAX_HEADER_BYTES) throw new BadRequestError('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 - headerStart > MAX_HEADER_BYTES) throw new BadRequestError('Headers too large');
+
+  const headers = Object.create(null);
+  const headerLines = headerEnd === requestLineEnd
+    ? []
+    : receivedBytes.toString('latin1', headerStart, headerEnd).split('\r\n');
+  for (const line of headerLines) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).replace(/^[ \t]+|[ \t]+$/g, '');
+    if (colon <= 0 || INVALID_HEADER_NAME_PATTERN.test(name) || INVALID_HEADER_VALUE_PATTERN.test(value)) {
+      throw new BadRequestError('Invalid header');
+    }
+
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new BadRequestError('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+
+  if (headers['transfer-encoding'] !== undefined) throw new BadRequestError('Unsupported Transfer-Encoding');
+
+  let contentLength = 0;
+  if (headers['content-length'] !== undefined) {
+    const value = headers['content-length'];
+    contentLength = Number(value);
+    if (!/^\d+$/.test(value) || !Number.isSafeInteger(contentLength)) {
+      throw new BadRequestError('Invalid Content-Length');
+    }
+  }
+
+  const bodyStart = headerEnd + 4;
+  if (receivedBytes.length - bodyStart < contentLength) return null;
+
+  const [, method, target, version] = requestLineMatch;
+  return {
+    method,
+    target,
+    path: target.split('?')[0],
+    version,
+    headers,
+    body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+  };
+};
+
+module.exports = { BadRequestError, DEFAULT_MAX_REQUEST_LINE_BYTES, parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..6a05bd4
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,99 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { BadRequestError, parseRequest } = require('./request');
+
+const parse = (raw, limit) => parseRequest(Buffer.from(raw, 'latin1'), limit);
+
+test('parses the request line and case-insensitive headers', () => {
+  const request = parse('POST /echo?name=test HTTP/1.1\r\nHost: localhost\r\nX-Test: \tvalue \t\r\n\r\n');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.target, '/echo?name=test');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.equal(request.body.length, 0);
+});
+
+test('allows requests without headers and HTTP/1.0 requests', () => {
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').path, '/');
+});
+
+test('waits for the complete request line, headers and Content-Length body', () => {
+  const raw = 'POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello';
+  for (let length = 0; length < raw.length; length += 1) {
+    assert.equal(parse(raw.slice(0, length)), null, `prefix length ${length}`);
+  }
+  assert.equal(parse(raw).body.toString(), 'hello');
+});
+
+test('reads the body as bytes and consumes exactly Content-Length', () => {
+  const body = Buffer.from([0, 255, 195, 169, 13, 10]);
+  const raw = Buffer.concat([
+    Buffer.from('POST /echo HTTP/1.1\r\ncOnTeNt-LeNgTh: 6\r\n\r\n'),
+    body,
+    Buffer.from('extra'),
+  ]);
+  assert.deepEqual(parseRequest(raw).body, body);
+});
+
+test('accepts zero Content-Length and combines repeated non-framing headers', () => {
+  const request = parse('GET / HTTP/1.1\r\nContent-Length: 0\r\nX-Test: one\r\nX-Test: two\r\n\r\n');
+  assert.equal(request.body.length, 0);
+  assert.equal(request.headers['x-test'], 'one, two');
+});
+
+for (const line of [
+  'GET /',
+  'GET / HTTP/2.0',
+  'GET / INVALID',
+  'GET  / HTTP/1.1',
+  'G\tET / HTTP/1.1',
+  'GET /with space HTTP/1.1',
+  'GET / HTTP/1.1\n',
+]) {
+  test(`rejects malformed request line ${JSON.stringify(line)}`, () => {
+    assert.throws(() => parse(`${line}\r\n\r\n`), BadRequestError);
+  });
+}
+
+for (const header of [
+  'No-Colon',
+  ': empty-name',
+  'Bad Name: value',
+  'Host : localhost',
+  'Host\n: localhost',
+  'Host\r: localhost',
+  ' folded: value',
+  'X-Test: bad\x00value',
+  'X-Test: bad\nvalue',
+  'Content-Length: -1',
+  'Content-Length: +1',
+  'Content-Length: 1.5',
+  'Content-Length: 1e2',
+  'Content-Length: nope',
+  'Content-Length:',
+  'Content-Length: 9007199254740992',
+  'Content-Length: 1, 1',
+  'Content-Length: 1\r\ncontent-length: 1',
+  'Transfer-Encoding: chunked',
+  'Transfer-Encoding: chunked\r\nContent-Length: 1',
+]) {
+  test(`rejects malformed or unsupported header ${JSON.stringify(header)}`, () => {
+    assert.throws(() => parse(`POST /echo HTTP/1.1\r\n${header}\r\n\r\nx`), BadRequestError);
+  });
+}
+
+test('enforces the request-line limit without counting headers or body', () => {
+  const line = 'GET / HTTP/1.1\r\n';
+  assert.equal(parse(`${line}\r\n`, line.length).path, '/');
+  assert.throws(() => parse(`${line}\r\n`, line.length - 1), BadRequestError);
+  assert.throws(() => parse('GET /toolong', 8), BadRequestError);
+  assert.equal(parse('GET / HTTP/1.1\r', line.length), null);
+});
+
+test('rejects oversized complete and incomplete headers', () => {
+  const raw = `GET / HTTP/1.1\r\nX-Test: ${'x'.repeat(65536)}`;
+  assert.throws(() => parse(raw), BadRequestError);
+  assert.throws(() => parse(`${raw}\r\n\r\n`), BadRequestError);
+});
