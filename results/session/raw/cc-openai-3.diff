diff --git a/server.test.js b/server.test.js
new file mode 100644
index 0000000..5a18724
--- /dev/null
+++ b/server.test.js
@@ -0,0 +1,102 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { setTimeout: delay } = require('node:timers/promises');
+const { test } = require('node:test');
+const server = require('./server');
+
+const connect = async () => {
+  const conn = net.createConnection({ host: '127.0.0.1', port: server.address().port });
+  let response = '';
+  conn.setEncoding('latin1');
+  conn.on('data', (chunk) => { response += chunk; });
+  const finished = new Promise((resolve, reject) => {
+    conn.on('end', () => resolve(response));
+    conn.on('error', reject);
+    conn.setTimeout(2000, () => conn.destroy(new Error('Timed out waiting for a response')));
+  });
+  await once(conn, 'connect');
+  return { conn, finished, response: () => response };
+};
+
+const exchange = async (raw) => {
+  const { conn, finished } = await connect();
+  conn.end(raw);
+  return finished;
+};
+
+const assertResponse = (response, status, body = '') => {
+  const [headers, actualBody] = response.split('\r\n\r\n');
+  assert.equal(headers.split('\r\n')[0], `HTTP/1.1 ${status}`);
+  assert.equal(actualBody, body);
+  assert.ok(headers.includes(`Content-Length: ${Buffer.byteLength(body, 'latin1')}\r\n`));
+  assert.ok(headers.includes('Connection: close'));
+};
+
+test('server parses complete requests before routing', { timeout: 10000 }, async (t) => {
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+
+  await t.test('preserves the existing routes and method handling', async () => {
+    assertResponse(await exchange('GET / HTTP/1.1\r\nHost: localhost\r\n\r\n'), '200 OK');
+    assertResponse(await exchange('GET /users/alice/posts/42 HTTP/1.1\r\n\r\n'), '200 OK', 'alice 42');
+    assertResponse(await exchange('GET /missing HTTP/1.1\r\n\r\n'), '404 Not Found');
+    const response = await exchange('POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n');
+    assertResponse(response, '405 Method Not Allowed');
+    assert.ok(response.includes('Allow: GET\r\n'));
+  });
+
+  await t.test('echoes the method and path for different methods', async () => {
+    for (const method of ['GET', 'POST', 'PUT', 'DELETE']) {
+      const response = await exchange(`${method} /echo?name=test HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc`);
+      assertResponse(response, '200 OK', `${method} /echo`);
+      assert.ok(response.includes('Content-Type: text/plain\r\n'));
+    }
+  });
+
+  await t.test('waits for fragmented headers and a fragmented body', async () => {
+    const { conn, finished, response } = await connect();
+    t.after(() => conn.destroy());
+    conn.write('POST /echo HTTP/1.1\r\n');
+    await delay(30);
+    assert.equal(response(), '');
+    assert.equal(conn.readableEnded, false);
+    conn.write('Content-Len');
+    conn.write('gth: 5\r\nX-Test: value\r\n\r');
+    conn.write('\nhel');
+    await delay(30);
+    assert.equal(response(), '');
+    assert.equal(conn.readableEnded, false);
+    conn.end('lo');
+    assertResponse(await finished, '200 OK', 'POST /echo');
+  });
+
+  await t.test('returns 400 for malformed requests on any route', async () => {
+    for (const raw of [
+      'not a request\r\n\r\n',
+      'GET / HTTP/invalid\r\n\r\n',
+      'GET /missing HTTP/1.1\r\nBroken header\r\n\r\n',
+      'POST /echo HTTP/1.1\r\nContent-Length: nope\r\n\r\n',
+      'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 2\r\n\r\nab',
+      'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+    ]) {
+      assertResponse(await exchange(raw), '400 Bad Request');
+    }
+  });
+
+  await t.test('returns 400 when the client ends an incomplete request', async () => {
+    for (const raw of [
+      '',
+      'GET / HTTP/1.1',
+      'GET / HTTP/1.1\r\nHost: localhost\r\n',
+      'POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nabc',
+    ]) {
+      assertResponse(await exchange(raw), '400 Bad Request');
+    }
+  });
+
+  await t.test('rejects an oversized request line', async () => {
+    assertResponse(await exchange(`GET /${'x'.repeat(8192)} HTTP/1.1\r\n\r\n`), '400 Bad Request');
+  });
+});
