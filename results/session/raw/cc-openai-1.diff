diff --git a/request.js b/request.js
new file mode 100644
index 0000000..2077e60
--- /dev/null
+++ b/request.js
@@ -0,0 +1,51 @@
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\s\x00-\x1f\x7f]*) HTTP\/1\.[01]$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*([^\x00-\x08\x0a-\x1f\x7f]*)$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequest = (bytes, maxRequestLineBytes) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE_PATTERN.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match) throw new Error('Invalid request line');
+
+  const headerEnd = bytes.indexOf('\r\n\r\n', lineEnd);
+  if (headerEnd === -1) {
+    if (bytes.length - lineEnd >= MAX_HEADER_BYTES) throw new Error('Headers too long');
+    return null;
+  }
+  if (headerEnd - lineEnd > MAX_HEADER_BYTES) throw new Error('Headers too long');
+
+  const headers = Object.create(null);
+  const headerLines = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const header = HEADER_PATTERN.exec(line);
+    if (!header) throw new Error('Invalid header');
+    const name = header[1].toLowerCase();
+    const value = header[2].trim();
+    if (name === 'content-length' && headers[name] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[name] = headers[name] === undefined ? value : `${headers[name]}, ${value}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^\d+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headerEnd + 4;
+  const bodyLength = Number(length);
+  if (bytes.length - bodyStart < bodyLength) return null;
+
+  return {
+    method: match[1],
+    path: match[2],
+    headers,
+    body: bytes.subarray(bodyStart, bodyStart + bodyLength),
+  };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..412294c
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,94 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { test, before, after } = require('node:test');
+const { parseRequest } = require('./request');
+const { server } = require('./server');
+
+const parse = (text) => parseRequest(Buffer.from(text), 8192);
+
+before(() => new Promise((resolve) => server.listen(0, '127.0.0.1', resolve)));
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const exchange = (request) => new Promise((resolve, reject) => {
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.on('connect', () => socket.end(request));
+  socket.on('data', (chunk) => { response += chunk; });
+  socket.on('end', () => resolve(response));
+  socket.on('error', reject);
+});
+
+test('parses request line, case-insensitive headers and a byte-length body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nX-Test: value\r\ncOnTeNt-LeNgTh: 2\r\n\r\néextra');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers['x-test'], 'value');
+  assert.deepEqual(request.body, Buffer.from('é'));
+});
+
+test('waits for the complete headers and body', () => {
+  for (const text of ['GET /echo HTTP/1.1\r\n', 'GET /echo HTTP/1.1\r\nX: y\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc']) {
+    assert.equal(parse(text), null);
+  }
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed request lines, headers and body framing', async () => {
+  const invalid = [
+    'GET / HTTP/9.9\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\n Bad: value\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 1x\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 9007199254740992\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ];
+  for (const request of invalid) {
+    assert.throws(() => parse(request));
+    assert.match(await exchange(request), /^HTTP\/1\.1 400 Bad Request\r\n/);
+  }
+});
+
+test('enforces request line and header limits', () => {
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 8));
+  assert.throws(() => parse('GET / HTTP/1.1\r\nX: ' + 'a'.repeat(65536)));
+});
+
+test('echo and existing routes respond correctly', async () => {
+  assert.match(await exchange('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc'), /\r\n\r\nPOST \/echo$/);
+  assert.match(await exchange('GET / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 200 OK/);
+  assert.match(await exchange('GET /users/12/posts/34 HTTP/1.1\r\n\r\n'), /\r\n\r\n12 34$/);
+  assert.match(await exchange('POST / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 405 Method Not Allowed/);
+  assert.match(await exchange('GET /missing HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 404 Not Found/);
+});
+
+test('returns 400 when the connection ends mid-request', async () => {
+  for (const request of ['GET /echo HTTP/1.1\r\n', 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc']) {
+    assert.match(await exchange(request), /^HTTP\/1\.1 400 Bad Request/);
+  }
+});
+
+test('handles a request fragmented across TCP writes', () => new Promise((resolve, reject) => {
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.on('error', reject);
+  socket.on('connect', () => {
+    socket.write('POST /echo HTTP/1.1\r');
+    setTimeout(() => {
+      socket.write('\nContent-Length: 4\r\n\r\nab');
+      setTimeout(() => socket.end('cd'), 20);
+    }, 20);
+  });
+  socket.on('data', (chunk) => { response += chunk; });
+  socket.on('end', () => {
+    try {
+      assert.match(response, /\r\n\r\nPOST \/echo$/);
+      resolve();
+    } catch (error) { reject(error); }
+  });
+}));
