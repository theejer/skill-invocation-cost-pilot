diff --git a/request.js b/request.js
new file mode 100644
index 0000000..0b2d0c0
--- /dev/null
+++ b/request.js
@@ -0,0 +1,92 @@
+const TOKEN_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE_PATTERN = /^([^ ]+) ([^ ]+) (HTTP\/1\.[01])$/;
+const REQUEST_TARGET_PATTERN = /^(?:\/[^\x00-\x20\x7f#]*|\*)$/;
+const HEADER_VALUE_PATTERN = /^[\t\x20-\x7e\x80-\xff]*$/;
+const DEFAULT_MAX_REQUEST_LINE_BYTES = 8192;
+const MAX_HEADER_BYTES = 65536;
+
+const badRequest = () => {
+  throw new Error('Malformed HTTP request');
+};
+
+const parseRequestLine = (requestLine) => {
+  const match = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!match || /[\r\n]/.test(requestLine)) return badRequest();
+
+  const [, method, path, version] = match;
+  if (!TOKEN_PATTERN.test(method) || !REQUEST_TARGET_PATTERN.test(path)) return badRequest();
+  if (path === '*' && method !== 'OPTIONS') return badRequest();
+  return { method, path, version };
+};
+
+const parseHeaders = (headerLines) => {
+  const headers = Object.create(null);
+  for (const line of headerLines) {
+    if (/[\r\n]/.test(line)) return badRequest();
+    const colon = line.indexOf(':');
+    if (colon === -1) return badRequest();
+
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (!TOKEN_PATTERN.test(name) || !HEADER_VALUE_PATTERN.test(value)) return badRequest();
+
+    const key = name.toLowerCase();
+    const trimmedValue = value.replace(/^[ \t]+|[ \t]+$/g, '');
+    if (key === 'content-length' && headers[key] !== undefined) return badRequest();
+    headers[key] = headers[key] === undefined ? trimmedValue : `${headers[key]}, ${trimmedValue}`;
+  }
+
+  if (headers['transfer-encoding'] !== undefined) return badRequest();
+  if (headers['content-length'] !== undefined && !/^[0-9]+$/.test(headers['content-length'])) {
+    return badRequest();
+  }
+  return headers;
+};
+
+const createRequestParser = (maxRequestLineBytes = DEFAULT_MAX_REQUEST_LINE_BYTES) => {
+  let pendingBytes = Buffer.alloc(0);
+  let request;
+  let contentLength = 0;
+  let bodyBytes = 0;
+  const bodyChunks = [];
+
+  return (chunk) => {
+    if (!request) {
+      pendingBytes = Buffer.concat([pendingBytes, chunk]);
+      const requestLineEnd = pendingBytes.subarray(0, maxRequestLineBytes).indexOf('\r\n');
+      if (requestLineEnd === -1) {
+        if (pendingBytes.length >= maxRequestLineBytes || pendingBytes.includes('\n')) {
+          return badRequest();
+        }
+        return null;
+      }
+
+      const requestLine = parseRequestLine(pendingBytes.toString('latin1', 0, requestLineEnd));
+      const headerEnd = pendingBytes.indexOf('\r\n\r\n', requestLineEnd);
+      const headerBytes = (headerEnd === -1 ? pendingBytes.length : headerEnd + 4) - requestLineEnd - 2;
+      if (headerBytes > MAX_HEADER_BYTES) return badRequest();
+      if (headerEnd === -1) return null;
+
+      const headerLines = headerEnd === requestLineEnd
+        ? []
+        : pendingBytes.toString('latin1', requestLineEnd + 2, headerEnd).split('\r\n');
+      const headers = parseHeaders(headerLines);
+      contentLength = Number(headers['content-length'] ?? 0);
+      if (!Number.isSafeInteger(contentLength)) return badRequest();
+
+      request = { ...requestLine, headers };
+      chunk = pendingBytes.subarray(headerEnd + 4);
+      pendingBytes = null;
+    }
+
+    const bodyChunk = chunk.subarray(0, contentLength - bodyBytes);
+    if (bodyChunk.length > 0) {
+      bodyChunks.push(bodyChunk);
+      bodyBytes += bodyChunk.length;
+    }
+    if (bodyBytes < contentLength) return null;
+    return { ...request, body: Buffer.concat(bodyChunks, contentLength) };
+  };
+};
+
+module.exports = { createRequestParser, parseRequestLine };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..3c002f5
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,122 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { createRequestParser, parseRequestLine } = require('./request');
+const { routeRequest, routeRequestLine } = require('./router');
+
+const parse = (text) => createRequestParser()(Buffer.from(text, 'latin1'));
+
+const malformedRequests = [
+  'GET /echo\r\n\r\n',
+  'GET  /echo HTTP/1.1\r\n\r\n',
+  'G\tET /echo HTTP/1.1\r\n\r\n',
+  'GET /echo HTTP/2.0\r\n\r\n',
+  'GET /echo#fragment HTTP/1.1\r\n\r\n',
+  'GET * HTTP/1.1\r\n\r\n',
+  'GET /echo HTTP/1.1\n\n',
+  'GET /echo HTTP/1.1\r\nNo-Colon\r\n\r\n',
+  'GET /echo HTTP/1.1\r\nBad Name: value\r\n\r\n',
+  'GET /echo HTTP/1.1\r\nHost : localhost\r\n\r\n',
+  'GET /echo HTTP/1.1\r\n folded-header\r\n\r\n',
+  'GET /echo HTTP/1.1\r\nX-Test: value\x00\r\n\r\n',
+  'GET /echo HTTP/1.1\r\nX-Test: value\n\r\n\r\n',
+  ...['', '-1', '+1', '1.5', '1x', '1, 1', '9007199254740992'].map(
+    (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+  ),
+  'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 2\r\n\r\nx',
+  'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+  'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+  'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n',
+];
+
+test('parses the request line, case-insensitive headers, and body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh:\t5 \r\nX-Test: one\r\nX-Test: two\r\n\r\nhello');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.headers['content-length'], '5');
+  assert.equal(request.headers['x-test'], 'one, two');
+  assert.deepEqual(request.body, Buffer.from('hello'));
+});
+
+test('waits for the full request, including fragmented CRLF and body bytes', () => {
+  const bytes = Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello');
+  const parseRequest = createRequestParser();
+  for (let i = 0; i < bytes.length - 1; i += 1) {
+    assert.equal(parseRequest(bytes.subarray(i, i + 1)), null);
+  }
+  assert.deepEqual(parseRequest(bytes.subarray(-1)).body, Buffer.from('hello'));
+});
+
+test('handles every split of a request across two packets', () => {
+  const bytes = Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello');
+  for (let i = 1; i < bytes.length; i += 1) {
+    const parseRequest = createRequestParser();
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+    assert.deepEqual(parseRequest(bytes.subarray(i)).body, Buffer.from('hello'));
+  }
+});
+
+test('counts Content-Length in bytes and preserves binary bodies', () => {
+  const body = Buffer.from([0x00, 0xff, 0xc3, 0xa9, 0x0d, 0x0a]);
+  const parseRequest = createRequestParser();
+  assert.equal(parseRequest(Buffer.from(`POST /echo HTTP/1.1\r\nContent-Length: ${body.length}\r\n\r\n`)), null);
+  assert.equal(parseRequest(body.subarray(0, 3)), null);
+  assert.deepEqual(parseRequest(body.subarray(3)).body, body);
+});
+
+test('handles absent and zero Content-Length, and HTTP/1.0', () => {
+  for (const headers of ['', 'Content-Length: 0\r\n']) {
+    assert.deepEqual(parse(`GET /echo HTTP/1.0\r\n${headers}\r\n`).body, Buffer.alloc(0));
+  }
+});
+
+test('reads only the declared body length', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcGET / HTTP/1.1\r\n\r\n');
+  assert.deepEqual(request.body, Buffer.from('abc'));
+});
+
+test('waits for incomplete headers and bodies', () => {
+  assert.equal(parse('GET /echo HTTP/1.1\r\n'), null);
+  assert.equal(parse('GET /echo HTTP/1.1\r\nHost: localhost\r\n'), null);
+  assert.equal(parse('POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhell'), null);
+});
+
+test('rejects malformed request lines, headers, and body lengths', () => {
+  for (const text of malformedRequests) {
+    assert.throws(() => parse(text), /Malformed HTTP request/, JSON.stringify(text));
+  }
+});
+
+test('enforces the request-line byte limit including CRLF', () => {
+  const line = 'GET /echo HTTP/1.1\r\n';
+  const bytes = Buffer.from(`${line}\r\n`);
+  assert.equal(createRequestParser(Buffer.byteLength(line))(bytes).path, '/echo');
+  assert.throws(() => createRequestParser(Buffer.byteLength(line) - 1)(bytes));
+  assert.throws(() => createRequestParser(4)(Buffer.from('GET ')));
+});
+
+test('limits headers without applying that limit to the body', () => {
+  assert.throws(() => parse(`GET /echo HTTP/1.1\r\nX-Test: ${'x'.repeat(65536)}\r\n\r\n`));
+  assert.throws(() => parse(`GET /echo HTTP/1.1\r\nX-Test: ${'x'.repeat(65536)}`));
+  const body = 'x'.repeat(70000);
+  assert.equal(parse(`POST /echo HTTP/1.1\r\nContent-Length: ${body.length}\r\n\r\n${body}`).body.length, body.length);
+});
+
+test('echo accepts methods other than GET', () => {
+  for (const method of ['GET', 'POST', 'PUT', 'PATCH', 'DELETE']) {
+    const response = routeRequest(parse(`${method} /echo HTTP/1.1\r\n\r\n`));
+    assert.ok(response.startsWith('HTTP/1.1 200 OK\r\n'));
+    assert.ok(response.endsWith(`\r\n\r\n${method} /echo`));
+    assert.ok(response.includes(`Content-Length: ${Buffer.byteLength(`${method} /echo`)}\r\n`));
+  }
+});
+
+test('preserves existing routes and request-line routing entry point', () => {
+  assert.ok(routeRequestLine('GET / HTTP/1.1').startsWith('HTTP/1.1 200 OK\r\n'));
+  assert.ok(routeRequestLine('GET /users/42/posts/7 HTTP/1.1').endsWith('\r\n\r\n42 7'));
+  assert.ok(routeRequestLine('POST / HTTP/1.1').startsWith('HTTP/1.1 405 Method Not Allowed\r\n'));
+  assert.ok(routeRequestLine('GET /missing HTTP/1.1').startsWith('HTTP/1.1 404 Not Found\r\n'));
+  assert.ok(routeRequestLine('malformed').startsWith('HTTP/1.1 400 Bad Request\r\n'));
+  assert.throws(() => parseRequestLine('GET /echo HTTP/1.1\n'));
+});
