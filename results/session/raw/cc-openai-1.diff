diff --git a/server.test.js b/server.test.js
new file mode 100644
index 0000000..45255b3
--- /dev/null
+++ b/server.test.js
@@ -0,0 +1,77 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { setTimeout: delay } = require('node:timers/promises');
+const { after, before, test } = require('node:test');
+
+const originalPort = process.env.PORT;
+process.env.PORT = '0';
+const server = require('./server');
+if (originalPort === undefined) delete process.env.PORT;
+else process.env.PORT = originalPort;
+
+before(async () => {
+  if (!server.listening) await once(server, 'listening');
+});
+after(() => new Promise((resolve, reject) => {
+  server.close((error) => error ? reject(error) : resolve());
+}));
+
+const connect = () => {
+  const socket = net.createConnection({ host: '127.0.0.1', port: server.address().port });
+  const chunks = [];
+  socket.on('data', (chunk) => chunks.push(chunk));
+  socket.setTimeout(2000, () => socket.destroy(new Error('Request timed out')));
+  const response = once(socket, 'end').then(() => Buffer.concat(chunks).toString('latin1'));
+  return { socket, chunks, response };
+};
+
+const exchange = async (request) => {
+  const { socket, response } = connect();
+  socket.end(request, 'latin1');
+  return response;
+};
+
+test('serves echo over TCP after receiving a Content-Length body', async () => {
+  const response = await exchange('POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello');
+  assert.equal(response, 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 10\r\nConnection: close\r\n\r\nPOST /echo');
+});
+
+test('does not reply before the headers and complete body arrive', async () => {
+  const { socket, chunks, response } = connect();
+  socket.write('POST /echo HTTP/1.1\r\n');
+  await delay(30);
+  assert.equal(chunks.length, 0);
+  socket.write('Content-Length: 5\r\n\r\nhell');
+  await delay(30);
+  assert.equal(chunks.length, 0);
+  socket.end('o');
+  assert.ok((await response).endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('returns 400 for malformed or truncated requests and keeps serving', async () => {
+  const requests = [
+    'malformed\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBroken-Header\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: nope\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 2\r\n\r\nx',
+    'GET /echo HTTP/1.1\r\nX-Test: bad\x00value\r\n\r\n',
+    '',
+    'GET /echo HTTP/1.1',
+    'GET /echo HTTP/1.1\r\nHost: localhost\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhell',
+  ];
+  for (const request of requests) {
+    const response = await exchange(request);
+    assert.ok(response.startsWith('HTTP/1.1 400 Bad Request\r\n'), JSON.stringify(request));
+    assert.ok(response.endsWith('Content-Length: 0\r\nConnection: close\r\n\r\n'));
+  }
+  assert.ok((await exchange('GET /echo HTTP/1.1\r\n\r\n')).endsWith('\r\n\r\nGET /echo'));
+});
+
+test('preserves root, user-post, missing-route, and method responses over TCP', async () => {
+  assert.ok((await exchange('GET / HTTP/1.1\r\n\r\n')).startsWith('HTTP/1.1 200 OK\r\n'));
+  assert.ok((await exchange('GET /users/alice/posts/42 HTTP/1.1\r\n\r\n')).endsWith('\r\n\r\nalice 42'));
+  assert.ok((await exchange('GET /missing HTTP/1.1\r\n\r\n')).startsWith('HTTP/1.1 404 Not Found\r\n'));
+  assert.ok((await exchange('POST / HTTP/1.1\r\n\r\n')).startsWith('HTTP/1.1 405 Method Not Allowed\r\n'));
+});
