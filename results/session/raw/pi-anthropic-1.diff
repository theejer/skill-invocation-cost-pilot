new file mode 100644
index 0000000..08ed89f
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,37 @@
+const HEAD_END = '\r\n\r\n';
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +HTTP\/\d\.\d$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+
+// Parses a request head (everything before the blank line).
+// Returns { method, target, headers, contentLength } or null if malformed.
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  const match = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!match) return null;
+
+  const headers = {};
+  for (const line of headerLines) {
+    const headerMatch = HEADER_PATTERN.exec(line);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    const value = headerMatch[2];
+    if (name === 'content-length' && name in headers && headers[name] !== value) return null;
+    headers[name] = name in headers && name !== 'content-length'
+      ? `${headers[name]}, ${value}`
+      : value;
+  }
+
+  if ('transfer-encoding' in headers) return null; // not supported
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    if (!CONTENT_LENGTH_PATTERN.test(headers['content-length'])) return null;
+    contentLength = Number(headers['content-length']);
+    if (!Number.isSafeInteger(contentLength)) return null;
+  }
+
+  return { method: match[1], target: match[2], headers, contentLength };
+};
+
+module.exports = { HEAD_END, parseHead };
