diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..6506f12
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,46 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const HEAD_END = '\r\n\r\n';
+
+class ParseError extends Error {}
+
+const parseHead = (headText) => {
+  const [requestLine, ...headerLines] = headText.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) throw new ParseError('malformed request line');
+
+  const headers = {};
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_PATTERN.exec(headerLine);
+    if (!headerMatch) throw new ParseError('malformed header');
+    const name = headerMatch[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${headerMatch[2]}` : headerMatch[2];
+  }
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    if (!/^\d+$/.test(headers['content-length'])) throw new ParseError('bad Content-Length');
+    contentLength = Number(headers['content-length']);
+    if (!Number.isSafeInteger(contentLength)) throw new ParseError('bad Content-Length');
+  }
+
+  return { method: requestLineMatch[1], target: requestLineMatch[2], headers, contentLength };
+};
+
+const parseRequest = (receivedBytes, { maxHeadBytes, maxBodyBytes }) => {
+  const headEnd = receivedBytes.subarray(0, maxHeadBytes + HEAD_END.length).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    if (receivedBytes.length >= maxHeadBytes) throw new ParseError('head too large');
+    return null;
+  }
+  if (headEnd > maxHeadBytes) throw new ParseError('head too large');
+
+  const { contentLength, ...head } = parseHead(receivedBytes.toString('latin1', 0, headEnd));
+  if (contentLength > maxBodyBytes) throw new ParseError('body too large');
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length - bodyStart < contentLength) return null;
+  return { ...head, body: receivedBytes.subarray(bodyStart, bodyStart + contentLength) };
+};
+
+module.exports = { ParseError, parseRequest };
