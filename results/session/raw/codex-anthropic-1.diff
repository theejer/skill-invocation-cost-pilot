index 0000000..492dafc
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,37 @@
+﻿const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +(HTTP\/\d\.\d)$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*([^\r\n]*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+
+const parseHead = (head) => {
+  const [requestLine, ...headerLines] = head.split('\r\n');
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+
+  const [, method, target] = requestLineMatch;
+  const headers = {};
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+    const name = headerMatch[1].toLowerCase();
+    const value = headerMatch[2];
+    headers[name] = name in headers ? `${headers[name]}, ${value}` : value;
+  }
+
+  if ('transfer-encoding' in headers) return null;
+
+  let contentLength = 0;
+  if ('content-length' in headers) {
+    const values = headers['content-length'].split(', ');
+    if (!values.every((value) => value === values[0] && CONTENT_LENGTH_PATTERN.test(value))) {
+      return null;
+    }
+    contentLength = Number(values[0]);
+    if (!Number.isSafeInteger(contentLength)) return null;
+  }
+
+  const queryStart = target.indexOf('?');
+  const path = queryStart === -1 ? target : target.slice(0, queryStart);
+  return { method, target, path, headers, contentLength };
+};
+
+module.exports = { parseHead };
