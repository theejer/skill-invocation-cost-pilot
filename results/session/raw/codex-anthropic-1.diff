new file mode 100644
index 0000000..1588596
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,40 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +HTTP\/\d\.\d$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+
+const parseContentLength = (headers, maxBodyBytes) => {
+  const values = headers
+    .filter(([name]) => name === 'content-length')
+    .flatMap(([, value]) => value.split(',').map((part) => part.trim()));
+  if (values.length === 0) return 0;
+  if (!values.every((value) => CONTENT_LENGTH_PATTERN.test(value) && value === values[0])) {
+    return null;
+  }
+  const contentLength = Number(values[0]);
+  return Number.isSafeInteger(contentLength) && contentLength <= maxBodyBytes
+    ? contentLength
+    : null;
+};
+
+const parseRequestHead = (head, maxBodyBytes) => {
+  const [requestLine, ...headerLines] = head.split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return null;
+
+  const headers = [];
+  for (const headerLine of headerLines) {
+    const headerMatch = HEADER_LINE_PATTERN.exec(headerLine);
+    if (!headerMatch) return null;
+    headers.push([headerMatch[1].toLowerCase(), headerMatch[2]]);
+  }
+  if (headers.some(([name]) => name === 'transfer-encoding')) return null;
+
+  const contentLength = parseContentLength(headers, maxBodyBytes);
+  if (contentLength === null) return null;
+
+  const [, method, target] = requestLineMatch;
+  return { method, target, headers: Object.fromEntries(headers), contentLength };
+};
+
+module.exports = { parseRequestHead };
