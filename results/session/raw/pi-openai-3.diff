diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..3c4bdb7
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,39 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { parseRequest } = require('../request');
+const { routeRequest, routeRequestLine } = require('../router');
+const parse = (text) => parseRequest(Buffer.from(text));
+
+test('parses headers and waits for the complete byte-counted body', () => {
+  const head = 'POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\n';
+  const bytes = Buffer.from(head + 'é!');
+  for (let i = 0; i < bytes.length; i++) {
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+  }
+  const request = parseRequest(bytes);
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.body.toString(), 'é!');
+  assert.ok(routeRequest(request).endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('accepts requests without headers or a body and preserves existing routes', () => {
+  assert.equal(parse('GET / HTTP/1.1\r\n\r\n').body.length, 0);
+  assert.match(routeRequestLine('GET / HTTP/1.1'), /^HTTP\/1.1 200/);
+  assert.ok(routeRequestLine('GET /users/12/posts/34 HTTP/1.1').endsWith('12 34'));
+  assert.match(routeRequestLine('POST / HTTP/1.1'), /^HTTP\/1.1 405/);
+  assert.match(routeRequestLine('GET /missing HTTP/1.1'), /^HTTP\/1.1 404/);
+});
+
+test('rejects malformed request lines, headers and body framing', () => {
+  for (const text of [
+    'GET / INVALID\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 1x\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parse(text));
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n'), 8));
+});
