diff --git a/request.js b/request.js
new file mode 100644
index 0000000..3f4c171
--- /dev/null
+++ b/request.js
@@ -0,0 +1,54 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\s\x00-\x1f\x7f]*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE.exec(line);
+  if (!match) throw new Error('Invalid request line');
+  return { method: match[1], path: match[2] };
+};
+
+// Return null until a complete request (including its byte-counted body) arrives.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length > MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+
+  const headers = Object.create(null);
+  const headerText = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const rawValue = line.slice(colon + 1);
+    const value = rawValue.replace(/^[ \t]+|[ \t]+$/g, '');
+    if (colon < 1 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(rawValue)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && Object.hasOwn(headers, key)) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = Object.hasOwn(headers, key) ? `${headers[key]}, ${value}` : value;
+  }
+  // Chunked framing is not supported; never interpret it as an empty body.
+  if (Object.hasOwn(headers, 'transfer-encoding')) throw new Error('Unsupported Transfer-Encoding');
+  const lengthText = headers['content-length'] ?? '0';
+  if (!/^\d+$/.test(lengthText)) throw new Error('Invalid Content-Length');
+  const length = Number(lengthText);
+  if (!Number.isSafeInteger(length)) throw new Error('Invalid Content-Length');
+  const bodyStart = headerEnd + 4;
+  if (bytes.length - bodyStart < length) return null;
+  return { ...request, headers, body: bytes.subarray(bodyStart, bodyStart + length) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
