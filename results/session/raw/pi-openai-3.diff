new file mode 100644
index 0000000..78cc8cf
--- /dev/null
+++ b/request.js
@@ -0,0 +1,68 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) ([\x21-\x7e]+) (HTTP\/1\.[01])$/;
+const MAX_HEADER_BYTES = 65536;
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE.exec(line);
+  if (!match) throw new Error('Invalid request line');
+  const [, method, path, version] = match;
+  return { method, path, version };
+};
+
+// Returns null until the entire request (including its body) has arrived.
+const createRequestParser = (maxRequestLineBytes) => {
+  let received = Buffer.alloc(0);
+  let request;
+  let bodyStart;
+  let contentLength = 0;
+
+  return (chunk) => {
+    received = Buffer.concat([received, chunk]);
+    if (!request) {
+      const lineEnd = received.indexOf('\r\n');
+      if (lineEnd === -1) {
+        if (received.length >= maxRequestLineBytes) throw new Error('Request line too long');
+        return null;
+      }
+      if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+      parseRequestLine(received.toString('latin1', 0, lineEnd));
+
+      const headerEnd = received.indexOf('\r\n\r\n');
+      if (headerEnd === -1) {
+        if (received.length > MAX_HEADER_BYTES) throw new Error('Headers too large');
+        return null;
+      }
+      bodyStart = headerEnd + 4;
+      if (bodyStart > MAX_HEADER_BYTES) throw new Error('Headers too large');
+      const lines = received.toString('latin1', 0, headerEnd).split('\r\n');
+      request = { ...parseRequestLine(lines.shift()), headers: Object.create(null) };
+      for (const line of lines) {
+        const colon = line.indexOf(':');
+        const name = line.slice(0, colon);
+        const value = line.slice(colon + 1);
+        if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(value)) {
+          throw new Error('Invalid header');
+        }
+        const key = name.toLowerCase();
+        if (key === 'content-length' && request.headers[key] !== undefined) {
+          throw new Error('Duplicate Content-Length');
+        }
+        request.headers[key] = request.headers[key] === undefined
+          ? value.trim()
+          : `${request.headers[key]}, ${value.trim()}`;
+      }
+      // Only Content-Length framing is supported; never ignore another framing mode.
+      if (request.headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+      const length = request.headers['content-length'];
+      if (length !== undefined) {
+        if (!/^[0-9]+$/.test(length)) throw new Error('Invalid Content-Length');
+        contentLength = Number(length);
+        if (!Number.isSafeInteger(contentLength)) throw new Error('Content-Length too large');
+      }
+    }
+    if (received.length - bodyStart < contentLength) return null;
+    return { ...request, body: received.subarray(bodyStart, bodyStart + contentLength) };
+  };
+};
+
+module.exports = { createRequestParser, parseRequestLine };
