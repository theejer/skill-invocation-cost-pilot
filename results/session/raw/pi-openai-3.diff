diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..e55e50f
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,111 @@
+const assert = require('node:assert/strict');
+const { test, before, after } = require('node:test');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { createRequestParser } = require('../request');
+const { routeRequestLine } = require('../router');
+
+const parser = () => createRequestParser(8192);
+
+test('parses fragmented headers and a binary Content-Length body', () => {
+  const parse = parser();
+  assert.equal(parse(Buffer.from('POST /echo HTTP/1.1\r')), null);
+  assert.equal(parse(Buffer.from('\nHost: localhost\r\ncontent-LENGTH: 3\r\n\r\n')), null);
+  assert.equal(parse(Buffer.from([0, 255])), null);
+  const request = parse(Buffer.from([10]));
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([0, 255, 10]));
+});
+
+test('accepts empty bodies and HTTP/1.0', () => {
+  const request = parser()(Buffer.from('GET / HTTP/1.0\r\n\r\n'));
+  assert.equal(request.body.length, 0);
+});
+
+test('rejects malformed request lines, headers, and framing', () => {
+  for (const request of [
+    'GET / nonsense\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nNoColon\r\n\r\n',
+    'GET / HTTP/1.1\r\nHost : example\r\n\r\n',
+    'GET / HTTP/1.1\r\nX: value\nInjected: value\r\n\r\n',
+    ...['-1', 'abc', '1.5', '9007199254740992'].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) {
+    assert.throws(() => parser()(Buffer.from(request)), undefined, request);
+  }
+});
+
+test('enforces request line and header limits', () => {
+  assert.throws(() => createRequestParser(10)(Buffer.from('GET / HTTP/1.1\r\n\r\n')));
+  assert.throws(() => parser()(Buffer.from(`GET / HTTP/1.1\r\nX: ${'a'.repeat(65536)}`)));
+});
+
+test('retains existing routes and adds echo for any method', () => {
+  for (const [line, status, body] of [
+    ['GET / HTTP/1.1', 200, ''],
+    ['GET /users/12/posts/34 HTTP/1.1', 200, '12 34'],
+    ['POST / HTTP/1.1', 405, ''],
+    ['GET /missing HTTP/1.1', 404, ''],
+    ['POST /echo HTTP/1.1', 200, 'POST /echo'],
+  ]) {
+    const response = routeRequestLine(line);
+    assert.ok(response.startsWith(`HTTP/1.1 ${status}`));
+    assert.equal(response.split('\r\n\r\n')[1], body);
+  }
+});
+
+let child;
+let port;
+before(async () => {
+  // Capture the ephemeral listening port without changing the server's public API.
+  child = spawn(process.execPath, ['-e', `
+    const net = require('net');
+    const listen = net.Server.prototype.listen;
+    net.Server.prototype.listen = function (...args) {
+      this.once('listening', () => process.send(this.address().port));
+      return listen.apply(this, args);
+    };
+    require('./server');
+  `], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0', MAX_REQUEST_LINE_BYTES: '8192' },
+    stdio: ['ignore', 'pipe', 'pipe', 'ipc'],
+  });
+  port = await new Promise((resolve, reject) => {
+    child.once('message', resolve);
+    child.once('error', reject);
+    child.once('exit', (code) => reject(new Error(`Server exited: ${code}`)));
+  });
+});
+after(() => child?.kill());
+
+const exchange = (request) => new Promise((resolve, reject) => {
+  const socket = net.connect(port, '127.0.0.1');
+  let response = '';
+  socket.setTimeout(2000, () => socket.destroy(new Error('Request timed out')));
+  socket.on('error', reject);
+  socket.on('data', (chunk) => { response += chunk.toString('latin1'); });
+  socket.on('end', () => resolve(response));
+  socket.on('connect', () => socket.end(request));
+});
+
+test('server responds to a complete request and rejects malformed or truncated requests', async () => {
+  const response = await exchange('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ndata');
+  assert.ok(response.startsWith('HTTP/1.1 200 OK'));
+  assert.ok(response.endsWith('POST /echo'));
+  for (const request of [
+    'invalid\r\n\r\n',
+    'GET / HTTP/1.1\r\nBadHeader\r\n\r\n',
+    'GET / HTTP/1.1\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nabc',
+  ]) {
+    assert.ok((await exchange(request)).startsWith('HTTP/1.1 400 Bad Request'));
+  }
+});
