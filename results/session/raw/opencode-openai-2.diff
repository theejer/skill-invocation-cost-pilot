diff --git a/request.js b/request.js
new file mode 100644
index 0000000..2c06c6d
--- /dev/null
+++ b/request.js
@@ -0,0 +1,53 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([^ ]+) (\/[^\s\x00-\x20\x7f]*) HTTP\/1\.[01]$/;
+const MAX_HEADER_BYTES = 65536;
+
+// null means more bytes are needed; malformed input throws.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match || !TOKEN.test(match[1])) throw new Error('Invalid request line');
+
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length > MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headerEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+  const headers = Object.create(null);
+  const headerLines = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN.test(name) || /[^\t\x20-\x7e\x80-\xff]/.test(line.slice(colon + 1))) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+  // This server only supports Content-Length framing.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const lengthValue = headers['content-length'];
+  if (lengthValue !== undefined && !/^\d+$/.test(lengthValue)) throw new Error('Invalid Content-Length');
+  const contentLength = lengthValue === undefined ? 0 : Number(lengthValue);
+  if (!Number.isSafeInteger(contentLength)) throw new Error('Invalid Content-Length');
+  const bodyStart = headerEnd + 4;
+  if (bytes.length - bodyStart < contentLength) return null;
+  return {
+    method: match[1],
+    path: match[2],
+    headers,
+    body: bytes.subarray(bodyStart, bodyStart + contentLength),
+  };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..e2b84a0
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,57 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parseRequest } = require('./request');
+const { routeRequest, routeRequestLine } = require('./router');
+
+const parse = (text) => parseRequest(Buffer.from(text, 'latin1'));
+
+test('reads request line, case-insensitive headers and binary body', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\na\x00\xffextra');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([97, 0, 255]));
+  assert.ok(routeRequest(request).endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('waits for all headers and the complete declared body', () => {
+  const bytes = Buffer.from('POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\ntest');
+  for (let i = 0; i < bytes.length; i++) {
+    assert.equal(parseRequest(bytes.subarray(0, i)), null);
+  }
+  assert.equal(parseRequest(bytes).body.toString(), 'test');
+});
+
+test('accepts no headers and zero-length bodies', () => {
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+  assert.equal(parse('GET / HTTP/1.1\r\nContent-Length: 0\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed lines, headers and ambiguous body framing', () => {
+  const invalid = [
+    'GET / HTTP/9.9\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'G(ET / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nMissing-Colon\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nX: a\x00b\r\n\r\n',
+    ...['-1', '1.5', 'abc', '9007199254740992'].map((length) =>
+      `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ];
+  for (const text of invalid) assert.throws(() => parse(text), undefined, text);
+});
+
+test('enforces request line limit', () => {
+  assert.throws(() => parseRequest(Buffer.from('GET / HTTP/1.1\r\n\r\n'), 10));
+  assert.throws(() => parseRequest(Buffer.from('1234567890'), 10));
+});
+
+test('preserves existing routing and rejects malformed request lines', () => {
+  assert.match(routeRequestLine('GET / HTTP/1.1'), /^HTTP\/1.1 200 OK/);
+  assert.ok(routeRequestLine('GET /users/12/posts/34 HTTP/1.1').endsWith('12 34'));
+  assert.match(routeRequestLine('POST / HTTP/1.1'), /^HTTP\/1.1 405/);
+  assert.match(routeRequestLine('GET /missing HTTP/1.1'), /^HTTP\/1.1 404/);
+  assert.match(routeRequestLine('not a request'), /^HTTP\/1.1 400/);
+});
