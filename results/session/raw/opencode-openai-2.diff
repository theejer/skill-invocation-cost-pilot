@@ -0,0 +1,52 @@
+const TOKEN_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\x00-\x20\x7f]*) (HTTP\/1\.[01])$/;
+
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes || bytes.includes(0x0a)) {
+      throw new Error('Invalid request line');
+    }
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+
+  const match = REQUEST_LINE_PATTERN.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match) throw new Error('Invalid request line');
+
+  const headersEnd = bytes.indexOf('\r\n\r\n');
+  const headerText = bytes.toString('latin1', lineEnd + 2, headersEnd === -1 ? bytes.length : headersEnd);
+  if (/[^\r]\n|^\n|\r[^\n]/.test(headerText)) throw new Error('Invalid header line ending');
+  if (headersEnd === -1) return null;
+
+  const headers = Object.create(null);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN_PATTERN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(line)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+
+  // Only Content-Length framing is supported; never guess a transfer-encoded body's size.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const contentLength = headers['content-length'] ?? '0';
+  if (!/^\d+$/.test(contentLength)) throw new Error('Invalid Content-Length');
+  const bodyLength = Number(contentLength);
+  const bodyStart = headersEnd + 4;
+  if (!Number.isSafeInteger(bodyLength) || !Number.isSafeInteger(bodyStart + bodyLength)) {
+    throw new Error('Content-Length too large');
+  }
+  if (bytes.length < bodyStart + bodyLength) return null;
+
+  const [, method, path, version] = match;
+  return { method, path, version, headers, body: bytes.subarray(bodyStart, bodyStart + bodyLength) };
+};
+
+module.exports = { parseRequest };
