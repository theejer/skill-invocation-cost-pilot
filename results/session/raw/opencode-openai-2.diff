diff --git a/test/request.test.js b/test/request.test.js
new file mode 100644
index 0000000..b2f9704
--- /dev/null
+++ b/test/request.test.js
@@ -0,0 +1,50 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { parseRequest } = require('../request');
+
+const parse = (text, limit) => parseRequest(Buffer.from(text, 'latin1'), limit);
+
+test('parses request line, case-insensitive headers, and exact body bytes', () => {
+  const request = parse('POST /echo HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\nX-Test: one\r\nX-Test: two\r\n\r\néabextra');
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.version, 'HTTP/1.1');
+  assert.equal(request.headers.host, 'localhost');
+  assert.equal(request.headers['x-test'], 'one, two');
+  assert.deepEqual(request.body, Buffer.from([0xe9, 0x61, 0x62]));
+});
+
+test('waits for every byte of a fragmented request', () => {
+  const text = 'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\na\r\nb';
+  for (let i = 0; i < text.length; i++) assert.equal(parse(text.slice(0, i)), null);
+  assert.equal(parse(text).body.toString(), 'a\r\nb');
+});
+
+test('accepts requests without headers or bodies', () => {
+  assert.equal(parse('GET / HTTP/1.0\r\n\r\n').body.length, 0);
+});
+
+test('rejects malformed request lines, headers, and body framing', () => {
+  const invalid = [
+    'GET / HTTP/2.0\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\n\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET / HTTP/1.1\r\n Folded: value\r\n\r\n',
+    'GET / HTTP/1.1\r\nX-Test: a\nb\r\n\r\n',
+    ...['-1', '1.5', '+2', 'abc', '', '9007199254740992'].map(
+      (length) => `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`,
+    ),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\na',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+  ];
+  for (const text of invalid) assert.throws(() => parse(text), undefined, text);
+});
+
+test('preserves the configured request-line size limit', () => {
+  const line = 'GET / HTTP/1.1\r\n';
+  assert.ok(parse(`${line}\r\n`, line.length));
+  assert.throws(() => parse(`${line}\r\n`, line.length - 1));
+  assert.throws(() => parse('x'.repeat(16), 16));
+});
diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..5936ddc
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,68 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { test, before, after } = require('node:test');
+const server = require('../server');
+
+before(async () => {
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+});
+
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const connect = () => net.createConnection(server.address().port, '127.0.0.1');
+const readResponse = (socket) => new Promise((resolve, reject) => {
+  let response = '';
+  socket.setEncoding('latin1');
+  socket.setTimeout(2000, () => socket.destroy(new Error('Response timed out')));
+  socket.on('data', (chunk) => { response += chunk; });
+  socket.on('end', () => resolve(response));
+  socket.on('error', reject);
+});
+
+const send = (request) => {
+  const socket = connect();
+  const response = readResponse(socket);
+  socket.end(request);
+  return response;
+};
+
+test('echo responds with the method and path', async () => {
+  const response = await send('POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc');
+  assert.match(response, /^HTTP\/1\.1 200 OK\r\n/);
+  assert.match(response, /Content-Length: 10\r\n/);
+  assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('does not route before headers and the entire body arrive', async () => {
+  const socket = connect();
+  const response = readResponse(socket);
+  let replied = false;
+  socket.on('data', () => { replied = true; });
+  socket.write('POST /echo HTTP/1.1\r\n');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(replied, false);
+  socket.write('Content-Length: 4\r\n\r\nab');
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.equal(replied, false);
+  socket.end('cd');
+  assert.match(await response, /^HTTP\/1\.1 200 OK/);
+});
+
+test('malformed and truncated requests receive 400', async () => {
+  for (const request of [
+    'invalid\r\n\r\n',
+    'GET / HTTP/1.1\r\nInvalid Header\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: nope\r\n\r\n',
+    'GET / HTTP/1.1\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab',
+  ]) assert.match(await send(request), /^HTTP\/1\.1 400 Bad Request/);
+});
+
+test('existing routes retain their behavior', async () => {
+  assert.match(await send('GET / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 200 OK/);
+  assert.ok((await send('GET /users/12/posts/34 HTTP/1.1\r\n\r\n')).endsWith('\r\n\r\n12 34'));
+  assert.match(await send('POST / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 405 Method Not Allowed/);
+  assert.match(await send('GET /missing HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 404 Not Found/);
+});
