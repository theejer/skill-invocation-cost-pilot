diff --git a/test/server.test.js b/test/server.test.js
new file mode 100644
index 0000000..012745f
--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,88 @@
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { test, before, after } = require('node:test');
+const server = require('../server');
+const { parseRequest } = require('../request');
+
+before(async () => {
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+});
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const exchange = async (request) => {
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  socket.setTimeout(2000, () => socket.destroy(new Error('Request timed out')));
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk.toString('latin1'); });
+  const ended = once(socket, 'end');
+  await once(socket, 'connect');
+  socket.end(request);
+  await ended;
+  return response;
+};
+
+test('parses headers case-insensitively and reads the exact body bytes', () => {
+  const bytes = Buffer.from('POST /echo?q=1 HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\nX-Test: value\r\n\r\n\xc3\xa9!ignored', 'latin1');
+  const request = parseRequest(bytes);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([0xc3, 0xa9, 0x21]));
+  const completeLength = bytes.length - 'ignored'.length;
+  for (let length = 0; length < completeLength; length++) {
+    assert.equal(parseRequest(bytes.subarray(0, length)), null);
+  }
+});
+
+test('echo supports arbitrary methods and a Content-Length body', async () => {
+  const response = await exchange('POST /echo HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello');
+  assert.match(response, /^HTTP\/1\.1 200 OK\r\n/);
+  assert.match(response, /Content-Length: 10\r\n/);
+  assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+});
+
+test('waits for fragmented headers and the entire body before routing', async () => {
+  const socket = net.connect(server.address().port, '127.0.0.1');
+  socket.setTimeout(2000, () => socket.destroy(new Error('Request timed out')));
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk.toString(); });
+  const ended = once(socket, 'end');
+  await once(socket, 'connect');
+  for (const part of ['POST /echo HTTP/1.1\r', '\nContent-Length: 5\r\n', '\r\nhel']) {
+    socket.write(part);
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    assert.equal(response, '');
+  }
+  socket.end('lo');
+  await ended;
+  assert.ok(response.endsWith('POST /echo'));
+});
+
+test('existing routes and method restrictions remain available', async () => {
+  assert.match(await exchange('GET / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 200 OK/);
+  assert.ok((await exchange('GET /users/12/posts/34 HTTP/1.1\r\n\r\n')).endsWith('12 34'));
+  assert.match(await exchange('POST / HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 405 Method Not Allowed/);
+  assert.match(await exchange('GET /missing HTTP/1.1\r\n\r\n'), /^HTTP\/1\.1 404 Not Found/);
+});
+
+test('malformed and incomplete requests return 400', async () => {
+  const requests = [
+    '',
+    'GET /echo HTTP/1.1\r\n',
+    'GET /echo NOT-HTTP\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBroken header\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBad Name: value\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nX-Test: a\x00b\r\n\r\n',
+    ...['-1', '1.5', 'abc', '', '9007199254740992'].map((length) =>
+      `POST /echo HTTP/1.1\r\nContent-Length: ${length}\r\n\r\n`),
+    'POST /echo HTTP/1.1\r\nContent-Length: 2\r\nContent-Length: 2\r\n\r\nab',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nab',
+    `GET /${'a'.repeat(8192)} HTTP/1.1\r\n\r\n`,
+  ];
+  for (const request of requests) {
+    assert.match(await exchange(request), /^HTTP\/1\.1 400 Bad Request/, JSON.stringify(request));
+  }
+});
