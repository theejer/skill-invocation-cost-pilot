new file mode 100644
index 0000000..2045461
--- /dev/null
+++ b/request.js
@@ -0,0 +1,60 @@
+const TOKEN = "[!#$%&'*+\\-.^_`|~0-9A-Za-z]+";
+const REQUEST_LINE_PATTERN = new RegExp(`^(${TOKEN}) (/[^\\x00-\\x20\\x7f#]*|\\*) HTTP/(1\\.[01])$`);
+const HEADER_NAME_PATTERN = new RegExp(`^${TOKEN}$`);
+const MAX_HEADER_BYTES = 65536;
+
+const badRequest = () => {
+  throw new Error('Malformed HTTP request');
+};
+
+const parseRequestLine = (line) => {
+  const match = REQUEST_LINE_PATTERN.exec(line);
+  if (!match) return badRequest();
+  const [, method, target, version] = match;
+  return { method, target, path: target.split('?')[0], version };
+};
+
+// Returns null until the complete request (including its body) is available.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.subarray(0, maxRequestLineBytes).indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) return badRequest();
+    return null;
+  }
+  const request = parseRequestLine(bytes.toString('latin1', 0, lineEnd));
+  const headerEnd = bytes.indexOf('\r\n\r\n');
+  if (headerEnd === -1) {
+    if (bytes.length >= MAX_HEADER_BYTES) return badRequest();
+    return null;
+  }
+  const bodyStart = headerEnd + 4;
+  if (bodyStart > MAX_HEADER_BYTES) return badRequest();
+
+  const headers = Object.create(null);
+  const headerLines = bytes.toString('latin1', lineEnd + 2, headerEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    if (colon < 1 || !HEADER_NAME_PATTERN.test(line.slice(0, colon))) return badRequest();
+    const name = line.slice(0, colon).toLowerCase();
+    const rawValue = line.slice(colon + 1);
+    if (/[^\t\x20-\x7e\x80-\xff]/.test(rawValue)) return badRequest();
+    const value = rawValue.replace(/^[ \t]+|[ \t]+$/g, '');
+    // Reject ambiguous body framing, including repeated Content-Length fields.
+    if (name === 'content-length' && Object.hasOwn(headers, name)) return badRequest();
+    headers[name] = Object.hasOwn(headers, name) ? `${headers[name]}, ${value}` : value;
+  }
+  // Chunked transfer coding is not supported by this server.
+  if (Object.hasOwn(headers, 'transfer-encoding')) return badRequest();
+  let contentLength = 0;
+  if (Object.hasOwn(headers, 'content-length')) {
+    if (!/^[0-9]+$/.test(headers['content-length'])) return badRequest();
+    contentLength = Number(headers['content-length']);
+    if (!Number.isSafeInteger(contentLength) || !Number.isSafeInteger(bodyStart + contentLength)) {
+      return badRequest();
+    }
+  }
+  if (bytes.length - bodyStart < contentLength) return null;
+  return { ...request, headers, body: bytes.subarray(bodyStart, bodyStart + contentLength) };
+};
+
+module.exports = { parseRequest, parseRequestLine };
