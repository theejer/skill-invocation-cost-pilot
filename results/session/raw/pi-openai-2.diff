diff --git a/request.js b/request.js
new file mode 100644
index 0000000..f60c55c
--- /dev/null
+++ b/request.js
@@ -0,0 +1,54 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+) (\/[^\x00-\x20\x7f]*|\*) HTTP\/(1\.[01])$/;
+const MAX_HEADER_BYTES = 65536;
+
+// Return null until the entire request has arrived; throw on invalid framing.
+const parseRequest = (bytes, maxRequestLineBytes = 8192) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match) throw new Error('Invalid request line');
+
+  const headersEnd = bytes.indexOf('\r\n\r\n', lineEnd);
+  if (headersEnd === -1) {
+    if (bytes.length > MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headersEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+  const headers = Object.create(null);
+  const headerText = bytes.toString('latin1', lineEnd + 2, headersEnd);
+  for (const line of headerText ? headerText.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1).trim();
+    if (colon <= 0 || !TOKEN.test(name) || /[\x00-\x08\x0a-\x1f\x7f]/.test(line)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    headers[key] = headers[key] === undefined ? value : `${headers[key]}, ${value}`;
+  }
+  // Chunked and other transfer codings are not supported.
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'] ?? '0';
+  if (!/^[0-9]+$/.test(length) || !Number.isSafeInteger(Number(length))) {
+    throw new Error('Invalid Content-Length');
+  }
+  const bodyStart = headersEnd + 4;
+  if (bytes.length - bodyStart < Number(length)) return null;
+  return {
+    method: match[1],
+    path: match[2],
+    version: match[3],
+    headers,
+    body: bytes.subarray(bodyStart, bodyStart + Number(length)),
+  };
+};
+
+module.exports = { parseRequest };
diff --git a/request.test.js b/request.test.js
new file mode 100644
index 0000000..b24d5b8
--- /dev/null
+++ b/request.test.js
@@ -0,0 +1,40 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { parseRequest } = require('./request');
+const { routeRequest, routeRequestLine } = require('./router');
+
+const parse = (text) => parseRequest(Buffer.from(text, 'latin1'));
+
+test('waits for the request line, headers and complete byte-length body', () => {
+  const text = 'POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\n\xc3\xa9ok';
+  for (let i = 0; i < text.length; i++) assert.equal(parse(text.slice(0, i)), null);
+  const request = parse(text);
+  assert.equal(request.method, 'POST');
+  assert.equal(request.path, '/echo');
+  assert.equal(request.headers.host, 'localhost');
+  assert.deepEqual(request.body, Buffer.from([0xc3, 0xa9, 111, 107]));
+  assert.match(routeRequest(request), /200 OK[\s\S]*\r\n\r\nPOST \/echo$/);
+});
+
+test('accepts requests without headers or a body and preserves routes', () => {
+  assert.equal(parse('GET / HTTP/1.1\r\n\r\n').body.length, 0);
+  assert.match(routeRequestLine('GET / HTTP/1.1'), /200 OK/);
+  assert.match(routeRequestLine('GET /users/1/posts/2 HTTP/1.1'), /\r\n\r\n1 2$/);
+  assert.match(routeRequestLine('POST / HTTP/1.1'), /405 Method Not Allowed/);
+  assert.match(routeRequestLine('GET /missing HTTP/1.1'), /404 Not Found/);
+});
+
+test('rejects malformed request lines, headers and body framing', () => {
+  for (const text of [
+    'GET / nonsense\r\n\r\n',
+    'GET  / HTTP/1.1\r\n\r\n',
+    'GET / HTTP/1.1\r\nBroken\r\n\r\n',
+    'GET / HTTP/1.1\r\nBad Name: x\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: -1\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 1x\r\n\r\n',
+    'GET / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n',
+    'GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n',
+  ]) assert.throws(() => parse(text));
+  assert.match(routeRequestLine('invalid'), /400 Bad Request/);
+  assert.throws(() => parseRequest(Buffer.from('12345678'), 8));
+});
