diff --git a/server.test.js b/server.test.js
new file mode 100644
index 0000000..fff751c
--- /dev/null
+++ b/server.test.js
@@ -0,0 +1,89 @@
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { once } = require('node:events');
+const { parseRequestHead } = require('./request');
+
+process.env.PORT = '0';
+const server = require('./server');
+before(async () => {
+  if (!server.listening) await once(server, 'listening');
+});
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const exchange = (request) => new Promise((resolve, reject) => {
+  const socket = net.createConnection(server.address().port, '127.0.0.1');
+  let response = '';
+  socket.setTimeout(2000, () => socket.destroy(new Error('Response timeout')));
+  socket.on('error', reject);
+  socket.on('data', (chunk) => { response += chunk.toString('latin1'); });
+  socket.on('end', () => resolve(response));
+  socket.on('connect', () => socket.end(request));
+});
+
+test('existing routes and method restrictions', async () => {
+  assert.match(await exchange('GET / HTTP/1.1\r\n\r\n'), /^HTTP\/1.1 200 OK/);
+  assert.match(await exchange('GET /users/12/posts/34 HTTP/1.1\r\n\r\n'), /\r\n\r\n12 34$/);
+  assert.match(await exchange('POST / HTTP/1.1\r\n\r\n'), /^HTTP\/1.1 405/);
+  assert.match(await exchange('GET /missing HTTP/1.1\r\n\r\n'), /^HTTP\/1.1 404/);
+});
+
+test('echo accepts a method, query string, headers and binary body', async () => {
+  const response = await exchange(Buffer.concat([
+    Buffer.from('PATCH /echo?q=1 HTTP/1.1\r\nHost: localhost\r\ncOnTeNt-LeNgTh: 3\r\n\r\n'),
+    Buffer.from([0, 255, 10]),
+  ]));
+  assert.match(response, /^HTTP\/1.1 200 OK/);
+  assert.match(response, /Content-Length: 11\r\n/);
+  assert.ok(response.endsWith('\r\n\r\nPATCH /echo'));
+});
+
+test('waits for fragmented headers and the complete declared body', async () => {
+  const socket = net.createConnection(server.address().port, '127.0.0.1');
+  socket.on('error', () => {});
+  await once(socket, 'connect');
+  let response = '';
+  socket.on('data', (chunk) => { response += chunk.toString(); });
+  try {
+    for (const chunk of ['POST /echo HTTP/1.1\r', '\nContent-Length: 4\r\n', '\r\nab']) {
+      socket.write(chunk);
+      await new Promise((resolve) => setTimeout(resolve, 20));
+      assert.equal(response, '');
+    }
+    const ended = once(socket, 'end');
+    socket.end('cd');
+    await ended;
+    assert.ok(response.endsWith('\r\n\r\nPOST /echo'));
+  } finally {
+    socket.destroy();
+  }
+});
+
+test('malformed and truncated requests receive 400', async () => {
+  const requests = [
+    '', 'GET /echo HTTP/1.1\r\n',
+    'GET  /echo HTTP/1.1\r\n\r\n',
+    'GET /echo HTTP/2.0\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nBad Header: value\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nMissingColon\r\n\r\n',
+    'GET /echo HTTP/1.1\r\nX: a\nb\r\n\r\n',
+    ...['-1', 'abc', '1.5', '9007199254740992'].map((value) =>
+      `POST /echo HTTP/1.1\r\nContent-Length: ${value}\r\n\r\n`),
+    'POST /echo HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+    'POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n',
+    'POST /echo HTTP/1.1\r\nContent-Length: 4\r\n\r\nab',
+    `GET /${'x'.repeat(8192)} HTTP/1.1\r\n\r\n`,
+    `GET /echo HTTP/1.1\r\nX: ${'x'.repeat(65536)}\r\n\r\n`,
+  ];
+  for (const request of requests) {
+    assert.match(await exchange(request), /^HTTP\/1.1 400 Bad Request/, request.slice(0, 100));
+  }
+});
+
+test('parser exposes normalized headers and byte-counted body framing', () => {
+  const request = parseRequestHead(Buffer.from(
+    'POST /echo HTTP/1.0\r\nX-Test: one\r\nx-test: two\r\nContent-Length: 2\r\n\r\n'), 8192);
+  assert.equal(request.headers['x-test'], 'one, two');
+  assert.equal(request.contentLength, 2);
+  assert.equal(request.method, 'POST');
+});
