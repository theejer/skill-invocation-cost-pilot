diff --git a/request.js b/request.js
new file mode 100644
index 0000000..4aed7fd
--- /dev/null
+++ b/request.js
@@ -0,0 +1,50 @@
+const TOKEN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const REQUEST_LINE = /^([^ ]+) (\/[^\s\x00-\x1f\x7f]*) HTTP\/1\.[01]$/;
+const HEADER_VALUE = /^[\t\x20-\x7e\x80-\xff]*$/;
+const MAX_HEADER_BYTES = 65536;
+
+// Return null while incomplete; throw for malformed or unsupported framing.
+const parseRequestHead = (bytes, maxRequestLineBytes) => {
+  const lineEnd = bytes.indexOf('\r\n');
+  if (lineEnd === -1) {
+    if (bytes.length >= maxRequestLineBytes) throw new Error('Request line too long');
+    return null;
+  }
+  if (lineEnd + 2 > maxRequestLineBytes) throw new Error('Request line too long');
+  const match = REQUEST_LINE.exec(bytes.toString('latin1', 0, lineEnd));
+  if (!match || !TOKEN.test(match[1])) throw new Error('Invalid request line');
+
+  const headEnd = bytes.indexOf('\r\n\r\n');
+  if (headEnd === -1) {
+    if (bytes.length >= MAX_HEADER_BYTES) throw new Error('Headers too large');
+    return null;
+  }
+  if (headEnd + 4 > MAX_HEADER_BYTES) throw new Error('Headers too large');
+  const headers = Object.create(null);
+  const headerLines = bytes.toString('latin1', lineEnd + 2, headEnd);
+  for (const line of headerLines ? headerLines.split('\r\n') : []) {
+    const colon = line.indexOf(':');
+    const name = line.slice(0, colon);
+    const value = line.slice(colon + 1);
+    if (colon < 1 || !TOKEN.test(name) || !HEADER_VALUE.test(value)) {
+      throw new Error('Invalid header');
+    }
+    const key = name.toLowerCase();
+    if (key === 'content-length' && headers[key] !== undefined) {
+      throw new Error('Duplicate Content-Length');
+    }
+    const trimmed = value.trim();
+    headers[key] = headers[key] === undefined ? trimmed : `${headers[key]}, ${trimmed}`;
+  }
+  if (headers['transfer-encoding'] !== undefined) throw new Error('Unsupported Transfer-Encoding');
+  const length = headers['content-length'];
+  if (length !== undefined && !/^[0-9]+$/.test(length)) throw new Error('Invalid Content-Length');
+  const contentLength = length === undefined ? 0 : Number(length);
+  if (!Number.isSafeInteger(contentLength) || !Number.isSafeInteger(headEnd + 4 + contentLength)) {
+    throw new Error('Invalid Content-Length');
+  }
+  return { method: match[1], path: match[2].split('?')[0], target: match[2], headers,
+    bodyOffset: headEnd + 4, contentLength };
+};
+
+module.exports = { parseRequestHead };
