index 0000000..807c9dd
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,69 @@
+const LINE_END = '\r\n';
+const HEAD_END = '\r\n\r\n';
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+\-.^_`|~0-9A-Za-z]+):[ \t]*(.*?)[ \t]*$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+
+const INCOMPLETE = { status: 'incomplete' };
+const BAD_REQUEST = { status: 'bad' };
+
+const parseHeaders = (lines) => {
+  const headers = {};
+  for (const line of lines) {
+    const match = HEADER_LINE_PATTERN.exec(line);
+    if (!match) return null;
+    const name = match[1].toLowerCase();
+    headers[name] = name in headers ? `${headers[name]}, ${match[2]}` : match[2];
+  }
+  return headers;
+};
+
+const parseContentLength = (headers) => {
+  if (!('content-length' in headers)) return 0;
+  const values = headers['content-length'].split(',').map((value) => value.trim());
+  if (!values.every((value) => CONTENT_LENGTH_PATTERN.test(value) && value === values[0])) {
+    return null;
+  }
+  const length = Number(values[0]);
+  return Number.isSafeInteger(length) ? length : null;
+};
+
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const requestLineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (requestLineEnd === -1) {
+    return receivedBytes.length >= maxRequestLineBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    return receivedBytes.length >= maxHeaderBytes ? BAD_REQUEST : INCOMPLETE;
+  }
+
+  const [requestLine, ...headerLines] = receivedBytes.toString('latin1', 0, headEnd).split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return BAD_REQUEST;
+
+  const headers = parseHeaders(headerLines);
+  if (!headers) return BAD_REQUEST;
+
+  const contentLength = parseContentLength(headers);
+  if (contentLength === null) return BAD_REQUEST;
+  if (contentLength > maxBodyBytes) return { status: 'too_large' };
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    status: 'ok',
+    request: {
+      method,
+      target,
+      path: target.split(/[?#]/, 1)[0],
+      headers,
+      body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
