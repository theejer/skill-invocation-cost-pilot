--- a/README.md
+++ b/README.md
@@ -5,3 +5,14 @@ Run: `node server.js`
 Minimum Node.js version: 22
 
 Port: 8080
+
+
+Requests are parsed as a request line, headers and an optional `Content-Length` body.
+
+Routes:
+- `/` and `/users/:userId/posts/:postId`: `GET` only
+- `/echo`: any method; replies with `<METHOD> <path>` (query string omitted)
+
+Malformed requests (bad request line, bad header, invalid or conflicting `Content-Length`, oversized head or body, or a connection closed before the request is complete) get `400 Bad Request`.
+
+Limits (environment variables): `MAX_REQUEST_LINE_BYTES` (8192), `MAX_HEAD_BYTES` (16384), `MAX_BODY_BYTES` (1048576)
diff --git a/parser.js b/parser.js
new file mode 100644
index 0000000..da341ba
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,91 @@
+const DEFAULT_MAX_REQUEST_LINE_BYTES = 8192;
+const DEFAULT_MAX_HEAD_BYTES = 16384;
+const DEFAULT_MAX_BODY_BYTES = 1048576;
+const LINE_END = '\r\n';
+const HEAD_END = '\r\n\r\n';
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_LINE_PATTERN = /^([!#$%&'*+.^_`|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/;
+const DIGITS_PATTERN = /^\d+$/;
+
+const BAD = { status: 'bad' };
+const INCOMPLETE = { status: 'incomplete' };
+
+const readPositiveInteger = (name, defaultValue) => {
+  const configuredValue = process.env[name] ?? defaultValue;
+  const value = Number(configuredValue);
+  if (!Number.isSafeInteger(value) || value <= 0) {
+    throw new Error(`${name} must be a positive integer, got "${configuredValue}"`);
+  }
+  return value;
+};
+
+const MAX_REQUEST_LINE_BYTES = readPositiveInteger(
+  'MAX_REQUEST_LINE_BYTES',
+  DEFAULT_MAX_REQUEST_LINE_BYTES,
+);
+const MAX_HEAD_BYTES = Math.max(
+  readPositiveInteger('MAX_HEAD_BYTES', DEFAULT_MAX_HEAD_BYTES),
+  MAX_REQUEST_LINE_BYTES,
+);
+const MAX_BODY_BYTES = readPositiveInteger('MAX_BODY_BYTES', DEFAULT_MAX_BODY_BYTES);
+
+const parseHeaders = (headerLines) => {
+  const headers = new Map();
+  for (const line of headerLines) {
+    const match = HEADER_LINE_PATTERN.exec(line);
+    if (!match) return null;
+    const name = match[1].toLowerCase();
+    const values = headers.get(name) ?? [];
+    values.push(match[2]);
+    headers.set(name, values);
+  }
+  return headers;
+};
+
+const parseContentLength = (headers) => {
+  const values = headers.get('content-length');
+  if (!values) return 0;
+  if (!values.every((value) => DIGITS_PATTERN.test(value) && value === values[0])) return null;
+  const contentLength = Number(values[0]);
+  return Number.isSafeInteger(contentLength) ? contentLength : null;
+};
+
+// Returns { status: 'incomplete' }, { status: 'bad' }, or
+// { status: 'ok', request: { method, target, headers, body } }.
+const parseRequest = (receivedBytes) => {
+  const headEnd = receivedBytes.subarray(0, MAX_HEAD_BYTES + HEAD_END.length).indexOf(HEAD_END);
+  if (headEnd === -1) {
+    const requestLineEnd = receivedBytes
+      .subarray(0, MAX_REQUEST_LINE_BYTES)
+      .indexOf(LINE_END);
+    const requestLineTooLong =
+      requestLineEnd === -1 && receivedBytes.length >= MAX_REQUEST_LINE_BYTES;
+    return requestLineTooLong || receivedBytes.length > MAX_HEAD_BYTES ? BAD : INCOMPLETE;
+  }
+
+  const [requestLine, ...headerLines] = receivedBytes.toString('latin1', 0, headEnd).split(LINE_END);
+  if (requestLine.length > MAX_REQUEST_LINE_BYTES) return BAD;
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return BAD;
+
+  const headers = parseHeaders(headerLines);
+  if (!headers) return BAD;
+  const contentLength = parseContentLength(headers);
+  if (contentLength === null || contentLength > MAX_BODY_BYTES) return BAD;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    status: 'ok',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
