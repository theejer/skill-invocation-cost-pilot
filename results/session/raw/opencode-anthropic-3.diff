new file mode 100644
index 0000000..631458e
--- /dev/null
+++ b/parser.js
@@ -0,0 +1,65 @@
+const REQUEST_LINE_PATTERN = /^([^ ]+) +([^ ]+) +[^ ]+$/;
+const HEADER_NAME_PATTERN = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+const CONTENT_LENGTH_PATTERN = /^\d+$/;
+const LINE_END = '\r\n';
+const HEAD_END = '\r\n\r\n';
+
+const INCOMPLETE = { state: 'incomplete' };
+const BAD = { state: 'bad' };
+
+const parseHeaders = (headerLines) => {
+  const headers = new Map();
+  for (const line of headerLines) {
+    const separator = line.indexOf(':');
+    if (separator === -1) return null;
+    const name = line.slice(0, separator);
+    if (!HEADER_NAME_PATTERN.test(name)) return null;
+    const value = line.slice(separator + 1).trim();
+    const key = name.toLowerCase();
+    headers.set(key, headers.has(key) ? `${headers.get(key)}, ${value}` : value);
+  }
+  return headers;
+};
+
+const parseContentLength = (headers, maxBodyBytes) => {
+  if (!headers.has('content-length')) return 0;
+  const values = headers.get('content-length').split(',').map((value) => value.trim());
+  if (values.some((value) => value !== values[0] || !CONTENT_LENGTH_PATTERN.test(value))) return null;
+  const length = Number(values[0]);
+  return Number.isSafeInteger(length) && length <= maxBodyBytes ? length : null;
+};
+
+// Returns { state: 'incomplete' }, { state: 'bad' } or { state: 'ok', request }.
+const parseRequest = (receivedBytes, { maxRequestLineBytes, maxHeaderBytes, maxBodyBytes }) => {
+  const lineEnd = receivedBytes.subarray(0, maxRequestLineBytes).indexOf(LINE_END);
+  if (lineEnd === -1) return receivedBytes.length >= maxRequestLineBytes ? BAD : INCOMPLETE;
+
+  const headEnd = receivedBytes.subarray(0, maxHeaderBytes).indexOf(HEAD_END);
+  if (headEnd === -1) return receivedBytes.length >= maxHeaderBytes ? BAD : INCOMPLETE;
+
+  const [requestLine, ...headerLines] = receivedBytes.toString('latin1', 0, headEnd).split(LINE_END);
+  const requestLineMatch = REQUEST_LINE_PATTERN.exec(requestLine);
+  if (!requestLineMatch) return BAD;
+
+  const headers = parseHeaders(headerLines);
+  if (!headers || headers.has('transfer-encoding')) return BAD;
+
+  const contentLength = parseContentLength(headers, maxBodyBytes);
+  if (contentLength === null) return BAD;
+
+  const bodyStart = headEnd + HEAD_END.length;
+  if (receivedBytes.length < bodyStart + contentLength) return INCOMPLETE;
+
+  const [, method, target] = requestLineMatch;
+  return {
+    state: 'ok',
+    request: {
+      method,
+      target,
+      headers,
+      body: receivedBytes.subarray(bodyStart, bodyStart + contentLength),
+    },
+  };
+};
+
+module.exports = { parseRequest };
